@model IEnumerable<Cargobell.Shared.Models.Shipment>
@{
    Layout = "_CourierLayout";
    ViewData["Title"] = "Active Pipeline";

    var sortedShipments = Model
        .OrderBy(s => s.StatusId)
        .ThenBy(s => s.EstimatedDelivery);
}

<div class="terminal-fade-in">
    <div class="d-flex justify-content-between align-items-end mb-4 border-start border-gold ps-4">
        <div>
            <h4 class="text-secondary small mb-1 uppercase-tracking">Logistics Command</h4>
            <h2 class="text-gold fw-bold mb-0">ACTIVE MANIFESTS</h2>
        </div>
        <a href="/CourierPanel/CreateShipment" class="btn btn-gold px-4 py-2 small fw-bold">
            <i class="bi bi-plus-lg me-2"></i>CREATE MANIFEST
        </a>
    </div>

    <div class="row mb-4 g-2">
        <div class="col-md-6">
            <form method="get" action="/CourierPanel/Active" class="input-group">
                <span class="input-group-text bg-soft-black border-secondary text-gold">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="searchTerm" class="form-control bg-black text-white border-secondary font-monospace"
                       placeholder="SCAN ID OR SEARCH RECEIVER..." value="@Context.Request.Query["searchTerm"]">
                <button type="submit" class="btn btn-outline-gold uppercase-tracking px-4">Filter</button>
            </form>
        </div>
    </div>

    <div class="terminal-card shadow-lg">
        <table class="table table-dark table-hover mb-0 align-middle">
            <thead class="bg-soft-black">
                <tr class="text-gold uppercase-tracking small">
                    <th class="ps-4 py-3 border-0">Tracking ID</th>
                    <th class="py-3 border-0">Receiver Information</th>
                    <th class="py-3 border-0">Route Sector</th>
                    <th class="py-3 border-0">Financial (COD)</th>
                    <th class="py-3 border-0">Priority / ETA</th>
                    <th class="pe-4 py-3 border-0 text-end">Operations</th>
                </tr>
            </thead>
            <tbody class="border-top border-secondary">
                @if (!sortedShipments.Any())
                {
                    <tr><td colspan="6" class="text-center py-5 text-secondary uppercase-tracking">No active data streams found.</td></tr>
                }
                @foreach (var item in sortedShipments)
                {
                    string rName = "Custom Delivery Address";
                    string rPhone = "N/A";

                    if (item.Receiver != null)
                    {
                        rName = $"{item.Receiver.FirstName} {item.Receiver.LastName}";
                        rPhone = item.Receiver.PhoneNumber ?? "N/A";
                    }
                    else if (!string.IsNullOrEmpty(item.Notes) && item.Notes.Contains("DROP-OFF RECIPIENT:"))
                    {
                        try
                        {
                            var firstSplit = item.Notes.Split(new string[] { "DROP-OFF RECIPIENT: " }, StringSplitOptions.None)[1];
                            var secondSplit = firstSplit.Split(new string[] { ")." }, StringSplitOptions.None)[0];
                            var details = secondSplit.Split('(');
                            rName = details[0].Trim();
                            rPhone = details[1].Trim();
                        }
                        catch { }
                    }

                    <tr>
                        <td class="ps-4 py-4 fw-bold font-monospace text-gold">
                            <a href="/CourierPanel/ShipmentDetails/@item.ShipmentId" class="text-decoration-none text-gold">#@item.TrackingCode</a>
                        </td>
                        <td>
                            <div class="text-white fw-bold">@rName</div>
                            <div class="text-secondary small font-monospace">@rPhone</div>
                        </td>
                        <td>
                            <div class="small">@(item.DeliveryRoute?.EndLocation ?? "Inbound Sorting Hub")</div>
                            <div class="text-secondary" style="font-size: 0.7rem;">HUB: SEC-@item.DeliveryRouteId</div>
                        </td>
                        <td>
                            @if (item.IsCashOnDelivery)
                            {
                                <span class="text-success fw-bold font-monospace">€@item.CodAmount</span>
                                <div class="text-muted" style="font-size: 0.6rem;">CASH ONLY</div>
                            }
                            else
                            {
                                <span class="text-muted small">PREPAID</span>
                            }
                        </td>
                        <td>
                            <span class="badge border border-gold text-gold mb-1 d-block uppercase-tracking" style="font-size: 0.6rem;">@(item.Status?.Name ?? "IN TRANSIT")</span>
                            <div class="text-secondary small font-monospace">@(item.EstimatedDelivery?.ToString("MMM dd") ?? "TBD")</div>
                        </td>
                        <td class="pe-4 text-end">
                            <div class="btn-group">
                                <a href="/CourierPanel/ShipmentDetails/@item.ShipmentId" class="btn btn-sm btn-outline-secondary px-3">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <form action="/CourierPanel/MarkDelivered" method="post" class="d-inline">
                                    <input type="hidden" name="shipmentId" value="@item.ShipmentId" />
                                    <button type="submit" class="btn btn-sm btn-gold px-3">
                                        DELIVER
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>