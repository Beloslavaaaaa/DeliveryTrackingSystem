@model Cargobell.Shared.Models.ApplicationUser
@{
    Layout = "_CourierLayout";
    ViewData["Title"] = "Operations Dashboard";
}

<div class="row mb-5">
    <div class="col-md-12">
        <h2 class="text-white fw-bold">WELCOME, <span class="text-gold">@Model.FirstName.ToUpper()</span></h2>
        <p class="text-secondary">SYSTEM STATUS: <span class="text-success">OPERATIONAL</span> | @DateTime.Now.ToString("dd MMM yyyy HH:mm")</p>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="p-4 terminal-border bg-dark">
            <span class="text-secondary small fw-bold text-uppercase">Active Assignments</span>
            <h1 class="text-gold fw-bold mb-0">@ViewBag.MyActive</h1>
            <a href="/CourierPanel/Shipments?filter=active" class="btn btn-sm btn-outline-secondary mt-3">VIEW MANIFESTS</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-4 terminal-border bg-dark">
            <span class="text-secondary small fw-bold text-uppercase">Regional Pickups</span>
            <h1 class="text-white fw-bold mb-0">@ViewBag.Available</h1>
            <a href="/CourierPanel/Shipments?filter=available" class="btn btn-sm btn-outline-secondary mt-3">SCAN HUB</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-4 terminal-border bg-dark">
            <span class="text-secondary small fw-bold text-uppercase">COD Collected</span>
            <h1 class="text-success fw-bold mb-0">@ViewBag.TotalCollected.ToString("C")</h1>
            <span class="small text-muted">PENDING SETTLEMENT</span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="p-5 terminal-border bg-black text-center">
            <h4 class="text-gold mb-3">QUICK ACTIONS</h4>
            <div class="d-flex justify-content-center gap-3">
                <a href="/CourierPanel/CreateShipment" class="btn btn-gold px-5 py-3">CREATE NEW SHIPMENT</a>
                <a href="/CourierPanel/Users" class="btn btn-outline-light px-5 py-3">SEARCH USER DATABASE</a>
            </div>
        </div>
    </div>
</div>