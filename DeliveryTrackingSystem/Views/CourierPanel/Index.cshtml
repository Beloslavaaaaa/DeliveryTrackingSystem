@model Cargobell.Shared.Models.ApplicationUser
@{
    Layout = "_CourierLayout";
    ViewData["Title"] = "Operations Dashboard";
}

<div class="row mb-5">
    <div class="col-md-12">
        <h2 class="text-white fw-bold">WELCOME, <span class="text-gold">@Model.FirstName.ToUpper()</span></h2>
        <p class="text-secondary">SYSTEM STATUS: <span class="text-success">OPERATIONAL</span> | @DateTime.Now.ToString("dd MMM yyyy HH:mm")</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="p-4 terminal-border bg-dark" style="border-left: 4px solid #D4AF37;">
            <span class="text-secondary small fw-bold text-uppercase">Active Assignments</span>
            <h1 class="text-gold fw-bold mb-0">@ViewBag.ActiveCount</h1>
            <p class="small text-muted mt-2 mb-0">CURRENTLY IN MANIFEST</p>
        </div>
    </div>

    <div class="col-md-6">
        <div class="p-4 terminal-border bg-dark" style="border-left: 4px solid #198754;">
            <span class="text-secondary small fw-bold text-uppercase">Revenue Collected</span>
            <h1 class="text-success fw-bold mb-0">@ViewBag.TotalCollected.ToString("C")</h1>
            <span class="small text-muted">SETTLED FROM COMPLETED DELIVERIES</span>
        </div>
    </div>
</div>

<div class="mt-5 pt-5 border-top border-secondary">
    <p class="text-muted small">
        <i class="bi bi-info-circle me-2"></i>
        USE THE LATERAL NAVIGATION BAR TO ACCESS ACTIVE MANIFESTS OR USER DIRECTORY.
    </p>
</div>