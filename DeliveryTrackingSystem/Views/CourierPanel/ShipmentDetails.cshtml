@model Cargobell.Shared.Models.Shipment
@{
    Layout = "_CourierLayout";
    ViewData["Title"] = "Manifest Details";
}

<div class="container-fluid py-4" style="max-width: 1140px; margin: 0 auto;">
    <div class="mb-4 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <a href="/CourierPanel/Active" class="btn btn-outline-secondary btn-sm me-3 border-gold text-gold">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h2 class="text-white fw-bold mb-0" style="letter-spacing: -1px;">MANIFEST <span class="text-gold font-monospace">#@Model.TrackingCode</span></h2>
        </div>
        <span class="text-secondary small font-monospace">TIMESTAMP: @Model.CreatedAt.ToString("HH:mm:ss")</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="terminal-card p-4 h-100 border-secondary" style="background-color: #0c0c0c; border: 1px solid #222; border-radius: 6px;">
                <div class="row g-4">
                    <div class="col-md-6 border-end border-secondary">
                        <h6 class="text-gold uppercase-tracking small mb-3">Originator</h6>
                        <p class="mb-1 fw-bold text-white fs-5">@Model.Sender?.FirstName @Model.Sender?.LastName</p>
                        <p class="text-secondary small mb-0"><i class="bi bi-geo-alt me-1"></i> @Model.DeliveryRoute?.StartLocation</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-gold uppercase-tracking small mb-3">Target Destination</h6>
                        <p class="mb-1 fw-bold text-white fs-5">@Model.Receiver?.FirstName @Model.Receiver?.LastName</p>
                        <p class="text-gold small mb-1 font-monospace">@Model.Receiver?.PhoneNumber</p>
                        <p class="text-secondary small mb-0"><i class="bi bi-geo-fill me-1"></i> @Model.DeliveryRoute?.EndLocation</p>
                    </div>
                </div>

                <hr class="border-secondary my-4 opacity-25">

                <div class="row g-4">
                    <div class="col-md-4">
                        <label class="text-gold small fw-bold mb-2">ORIGIN HUB</label>
                        <div class="p-3 bg-soft-black rounded border border-secondary shadow-sm">
                            <div class="mb-2">
                                <span class="text-muted small d-block">ROUTE SECTOR</span>
                                <span class="text-white font-monospace">SEC-@Model.DeliveryRouteId</span>
                            </div>
                            <div>
                                <span class="text-muted small d-block">ESTIMATED TRANSIT</span>
                                <span class="text-white font-monospace">@Model.DeliveryRoute?.EstimatedTimeHours hrs</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <h6 class="text-gold uppercase-tracking small mb-2">Cargo Notes</h6>
                        <div class="p-3 bg-soft-black rounded border border-secondary h-100">
                            <p class="text-secondary small mb-0 font-italic">
                                @(string.IsNullOrEmpty(Model.Notes) ? "NO SPECIALIZED INSTRUCTIONS LOGGED." : Model.Notes)
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="terminal-card p-4 mb-4 border-gold bg-soft-black" style="border: 1px solid var(--gold-solid); border-radius: 6px;">
                <h6 class="text-gold uppercase-tracking small mb-3">Operational Status</h6>
                <div class="text-center py-3 bg-black border border-gold border-opacity-50 mb-3 rounded">
                    <span class="text-gold fw-bold uppercase-tracking">@Model.Status?.Name</span>
                </div>

                @if (Model.IsFragile)
                {
                    <div class="d-flex align-items-center p-2 mb-2 bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded">
                        <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
                        <span class="text-danger small fw-bold">FRAGILE CARGO</span>
                    </div>
                }

                @if (Model.IsCashOnDelivery)
                {
                    <div class="d-flex align-items-center p-2 bg-success bg-opacity-10 border border-success border-opacity-25 rounded">
                        <i class="bi bi-currency-euro text-success me-2"></i>
                        <span class="text-success small fw-bold">COLLECT: €@Model.CodAmount</span>
                    </div>
                }
            </div>

            <div class="terminal-card p-4 border-secondary shadow-sm" style="background-color: #0c0c0c; border: 1px solid #222; border-radius: 6px;">
                <h6 class="text-secondary uppercase-tracking small mb-3">Actions</h6>
                <div class="d-grid gap-2">
                    <form action="/CourierPanel/MarkDelivered" method="post">
                        <input type="hidden" name="shipmentId" value="@Model.ShipmentId" />
                        <button type="submit" class="btn btn-gold w-100 fw-bold">CONFIRM DELIVERY</button>
                    </form>

                    <button class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#statusModal">
                        UPDATE STATUS
                    </button>

                    <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#anomalyModal">
                        REPORT ANOMALY
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="statusModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-gold text-white" style="border: 1px solid #D4AF37;">
            <form action="/CourierPanel/UpdateStatus" method="post">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-gold">CHANGE MANIFEST STATUS</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="shipmentId" value="@Model.ShipmentId" />

                    <label class="small text-muted mb-2">NEW STATUS</label>
                    <select name="statusId" class="form-select bg-black text-white border-secondary mb-3">
                        @if (ViewBag.StatusList != null)
                        {
                            foreach (var status in (IEnumerable<Cargobell.Shared.Models.Status>)ViewBag.StatusList)
                            {
                                <option value="@status.StatusId" selected="@(Model.StatusId == status.StatusId)">
                                    @status.Name
                                </option>
                            }
                        }
                    </select>

                    <label class="small text-muted mb-2">OPERATIONAL NOTE</label>
                    <textarea name="note" class="form-control bg-black text-white border-secondary" rows="2" placeholder="Optional entry description..."></textarea>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">CANCEL</button>
                    <button type="submit" class="btn btn-gold">UPDATE</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="anomalyModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-danger text-white" style="border: 1px solid #dc3545;">
            <form action="/CourierPanel/ReportAnomaly" method="post">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-danger">REPORT LOGISTICS ANOMALY</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="shipmentId" value="@Model.ShipmentId" />
                    <label class="small text-muted mb-2">NATURE OF PROBLEM</label>
                    <select name="reason" class="form-select bg-black text-white border-danger mb-3">
                        <option value="Mechanical Failure">Mechanical Failure</option>
                        <option value="Weather Delay">Weather Delay</option>
                        <option value="Receiver Not Available">Receiver Not Available</option>
                        <option value="Incorrect Address">Incorrect Address</option>
                    </select>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">CANCEL</button>
                    <button type="submit" class="btn btn-danger">LOG ANOMALY</button>
                </div>
            </form>
        </div>
    </div>
</div>