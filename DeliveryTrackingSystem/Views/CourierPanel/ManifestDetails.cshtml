@model Cargobell.Shared.Models.Shipment
@{
    Layout = "_CourierLayout";
    ViewData["Title"] = $"Manifest Readout #{Model.TrackingCode}";

    string senderName = Model.Sender != null ? $"{Model.Sender.FirstName} {Model.Sender.LastName}" : "UNREGISTERED SENDER";
    string senderPhone = Model.Sender?.PhoneNumber ?? "N/A";
    string receiverName = Model.Receiver != null ? $"{Model.Receiver.FirstName} {Model.Receiver.LastName}" : "UNREGISTERED RECIPIENT";
    string receiverPhone = Model.Receiver?.PhoneNumber ?? "N/A";

    string startLocation = Model.DeliveryRoute?.StartLocation ?? "Main Distribution Hub";
    string finalDest = Model.DeliveryRoute?.EndLocation ?? "Custom Local Node";

    decimal costCalculated = Model.ShippingCost;

    if (!string.IsNullOrEmpty(Model.Notes))
    {
        if (Model.Notes.Contains("GUEST_SENDER_NAME:"))
            senderName = Model.Notes.Split("GUEST_SENDER_NAME: ")[1].Split(" | ")[0] + " [GUEST]";

        if (Model.Notes.Contains("GUEST_SENDER_PHONE:"))
            senderPhone = Model.Notes.Split("GUEST_SENDER_PHONE: ")[1].Split(" | ")[0];

        if (Model.Notes.Contains("GUEST_RECEIVER_NAME:"))
            receiverName = Model.Notes.Split("GUEST_RECEIVER_NAME: ")[1].Split(" | ")[0] + " [GUEST]";

        if (Model.Notes.Contains("GUEST_RECEIVER_PHONE:"))
            receiverPhone = Model.Notes.Split("GUEST_RECEIVER_PHONE: ")[1].Split(" | ")[0];

        if (Model.Notes.Contains("DESTINATION_LOCATION:"))
            finalDest = Model.Notes.Split("DESTINATION_LOCATION: ")[1].Split(" | ")[0];

        if (Model.Notes.Contains("START_LOCATION:"))
            startLocation = Model.Notes.Split("START_LOCATION: ")[1].Split(" | ")[0];
    }
}

<style>
    .terminal-card {
        background-color: #0c0c0c;
        border: 1px solid #222;
        border-radius: 4px;
        height: 100%;
    }

    .data-point {
        background: rgba(255,255,255,0.03);
        border: 1px solid #1a1a1a;
        padding: 15px;
    }

    .label-meta {
        color: #D4AF37;
        font-family: monospace;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        display: block;
        margin-bottom: 5px;
    }

    .timeline-track {
        border-left: 2px solid #222;
        padding-left: 20px;
        margin-left: 10px;
    }

    .timeline-item {
        position: relative;
        padding-bottom: 20px;
    }

        .timeline-item::before {
            content: "";
            position: absolute;
            left: -27px;
            top: 5px;
            width: 12px;
            height: 12px;
            background: #D4AF37;
            border-radius: 50%;
        }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-25">
        <div>
            <a href="/CourierPanel/History" class="btn btn-outline-secondary btn-sm mb-2 font-monospace">
                <i class="bi bi-chevron-left"></i> BACK TO LEDGER
            </a>
            <h2 class="text-white fw-bold font-monospace mb-0">READOUT // <span class="text-gold">#@Model.TrackingCode</span></h2>
        </div>
        <div class="text-end">
            <span class="badge bg-success font-monospace px-3 py-2">● ARCHIVED_STABLE</span>
            <div class="text-muted small mt-2 font-monospace">ID: @Model.ShipmentId.ToString().PadLeft(8, '0')</div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="terminal-card p-4 mb-4">
                <h6 class="text-secondary font-monospace mb-4">[01] LOGISTICS NODES</h6>
                <div class="row">
                    <div class="col-md-6 border-end border-secondary border-opacity-25">
                        <label class="label-meta">Originator (Sender)</label>
                        <h5 class="text-white mb-1">@senderName</h5>
                        <p class="text-gold font-monospace small mb-0">@senderPhone</p>
                    </div>
                    <div class="col-md-6 ps-md-4">
                        <label class="label-meta">Terminal Target (Receiver)</label>
                        <h5 class="text-white mb-1">@receiverName</h5>
                        <p class="text-gold font-monospace small mb-0">@receiverPhone</p>
                    </div>
                </div>
            </div>

            <div class="terminal-card p-4 mb-4">
                <h6 class="text-secondary font-monospace mb-4">[02] ROUTE VECTORS</h6>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="data-point">
                            <label class="label-meta">Pickup Address</label>
                            <span class="text-white">@startLocation</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="data-point">
                            <label class="label-meta">Destination Hub / Address</label>
                            <span class="text-white">@finalDest</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="terminal-card p-4">
                <h6 class="text-secondary font-monospace mb-4">[03] CARGO DIAGNOSTICS</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="data-point text-center">
                            <label class="label-meta">Freight Charge</label>
                            <h4 class="text-white mb-0">€@costCalculated.ToString("N2")</h4>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="data-point text-center">
                            <label class="label-meta">COD Value Collected</label>
                            <h4 class="text-success mb-0">€@Model.CodAmount.ToString("N2")</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="terminal-card p-4 mb-4">
                <h6 class="text-secondary font-monospace mb-4">[04] SYSTEM TIMELINE</h6>
                <div class="timeline-track">
                    <div class="timeline-item">
                        <span class="label-meta">Delivered / Settled</span>
                        <div class="text-white small">@(Model.DeliveredDate?.ToString("f") ?? "Manifest Closed")</div>
                    </div>
                    <div class="timeline-item">
                        <span class="label-meta">In Transit</span>
                        <div class="text-white-50 small">Logistics hub handover complete.</div>
                    </div>
                    <div class="timeline-item" style="padding-bottom:0;">
                        <span class="label-meta">Initialized</span>
                        <div class="text-white-50 small">@Model.CreatedAt.ToString("f")</div>
                    </div>
                </div>
            </div>

            <div class="terminal-card p-4">
                <h6 class="text-secondary font-monospace mb-3">[05] OPERATIONAL NOTES</h6>
                <div class="p-3 bg-black border border-secondary border-opacity-25 rounded">
                    <p class="text-muted small mb-0 font-monospace" style="line-height: 1.6;">
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            @Model.Notes
                        }
                        else
                        {
                            @:NO SUPPLEMENTARY INSTRUCTIONS LOGGED FOR THIS ASSET.
                        }
                    </p>
                </div>
                <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <button class="btn btn-gold w-100 fw-bold font-monospace py-2" onclick="window.print()">
                        <i class="bi bi-printer me-2"></i> PRINT MANIFEST
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>