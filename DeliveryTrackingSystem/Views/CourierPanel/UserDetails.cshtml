@model DeliveryTrackingSystem.Controllers.UserRequestViewModel
@{
    Layout = "_CourierLayout";
    ViewData["Title"] = "Node Core Diagnostics";
    var userRequests = (List<Cargobell.Shared.Models.CourierRequest>)ViewBag.UserRequests;
}

<div class="container-fluid py-4 text-white" style="background-color: #050505; font-family: 'Courier New', Courier, monospace;">

    <div class="mb-4">
        <a href="/CourierPanel/Users" class="text-gold text-decoration-none font-monospace small text-uppercase" style="letter-spacing: 1px;">
            <i class="bi bi-arrow-left me-2"></i> Return to Registry Matrix View
        </a>
    </div>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end pb-3 mb-5 border-bottom border-secondary">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="spinner-grow spinner-grow-sm text-gold" role="status" style="width: 10px; height: 10px;"></span>
                <h6 class="text-muted small mb-0 text-uppercase tracking-wider">Logistics Control Subsystem</h6>
            </div>
            <h1 class="text-gold fw-bold tracking-tight mb-0" style="color: #d4af37; text-shadow: 0 0 10px rgba(212,175,55,0.2);">PROFILE DIAGNOSTICS: @Model.User.FirstName.ToUpper() @Model.User.LastName.ToUpper()</h1>
        </div>
        <div class="mt-3 mt-md-0 font-monospace text-md-end">
            <span class="badge border px-3 py-1 tracking-widest text-uppercase"
                  style="font-size: 0.65rem; color: #d4af37; border-color: #d4af37; background-color: rgba(212,175,55,0.05);">
                @(Model.User.IsApproved ? "AUTHORIZED NETWORK NODE" : "VERIFICATION REQUISITION PENDING")
            </span>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-4 col-md-5">
            <div class="card bg-black rounded-0 border-secondary h-100" style="background: #0d0d0d; border: 1px solid #222;">
                <div class="card-header bg-black border-bottom border-secondary py-3 px-4 rounded-0">
                    <h6 class="text-gold font-monospace fw-bold mb-0 text-uppercase tracking-widest">
                        <i class="bi bi-person-bounding-box me-2"></i> Registry Fields
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex flex-column gap-4">
                        <div>
                            <small class="text-muted tracking-widest d-block text-uppercase" style="font-size: 0.65rem;">Identified Operator</small>
                            <div class="text-white fw-bold fs-5 mt-1">@Model.User.FirstName @Model.User.LastName</div>
                        </div>

                        <div>
                            <small class="text-muted tracking-widest d-block text-uppercase" style="font-size: 0.65rem;">Communications Array</small>
                            <div class="text-white font-monospace mt-1"><i class="bi bi-telephone text-gold me-2"></i>@Model.User.PhoneNumber</div>
                            <div class="text-white font-monospace mt-1"><i class="bi bi-envelope text-gold me-2"></i>@Model.User.Email</div>
                        </div>

                        <div>
                            <small class="text-muted tracking-widest d-block text-uppercase" style="font-size: 0.65rem;">System Reference Key</small>
                            <div class="text-muted font-monospace mt-1" style="font-size: 0.75rem; word-break: break-all;">@Model.User.Id</div>
                        </div>

                        <hr class="border-secondary my-1">

                        <div>
                            <small class="text-danger tracking-widest d-block text-uppercase font-monospace mb-2" style="font-size: 0.65rem;">[ Critical Safety Intercept ]</small>

                            <button type="button" class="btn btn-outline-danger font-monospace rounded-0 w-100 py-2 fw-bold text-uppercase"
                                    onclick="document.getElementById('purgeConfirmSection').classList.toggle('d-none')">
                                <i class="bi bi-exclamation-octagon me-2"></i> Purge Profile Record
                            </button>

                            <div id="purgeConfirmSection" class="d-none mt-3 p-3 bg-black border border-danger font-monospace rounded-0 animate-fade-in">
                                <p class="text-danger small fw-bold mb-3 text-uppercase" style="font-size:0.72rem; line-height:1.4;">
                                    WARNING: This permanently drops this profile cluster block and purges all tied manifest entities.
                                </p>
                                <form asp-controller="CourierPanel" asp-action="DeleteUserProfile" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.User.Id" />
                                    <button type="submit" class="btn btn-danger text-black font-monospace fw-bold w-100 rounded-0 text-uppercase py-2" style="background-color: #dc3545; border: none;">
                                        Execute Purge Protocol
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-8 col-md-7">
            <div class="card bg-black rounded-0 border-secondary h-100" style="background: #0d0d0d; border: 1px solid #222;">
                <div class="card-header bg-black border-bottom border-secondary py-3 px-4 rounded-0">
                    <h6 class="text-gold font-monospace fw-bold mb-0 text-uppercase tracking-widest">
                        <i class="bi bi-hdd-network me-2"></i> Manifest Demands Assigned (@userRequests.Count)
                    </h6>
                </div>
                <div class="card-body p-4">
                    @if (!userRequests.Any())
                    {
                        <div class="text-center py-5 border border-dashed border-secondary font-monospace" style="background-color: #090909; border-opacity: 0.3;">
                            <i class="bi bi-hdd-stack text-muted fs-4 d-block mb-2"></i>
                            <span class="text-muted small text-uppercase">[ No active or legacy demands registered for this node reference ]</span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3" style="max-height: 520px; overflow-y: auto;">
                            @foreach (var req in userRequests)
                            {
                                <div class="p-4 rounded-0 font-monospace" style="background: #121212; border: 1px solid #262626; border-left: 4px solid @(req.IsCompleted ? "#1aa34a" : "#d4af37");">
                                    <div class="row g-3">
                                        <div class="col-12 d-flex justify-content-between align-items-start">
                                            <div>
                                                <small class="text-muted tracking-widest d-block text-uppercase" style="font-size: 0.6rem;">Package Core Data</small>
                                                <div class="text-white fw-bold fs-6 mt-1"><i class="bi bi-box-seam me-2 text-gold"></i>@req.PackageDescription</div>
                                            </div>
                                            <span class="badge font-monospace text-uppercase" style="font-size:0.65rem; background-color: rgba(255,255,255,0.05); color: @(req.IsCompleted ? "#1aa34a" : "#d4af37"); border: 1px solid @(req.IsCompleted ? "#1aa34a" : "#d4af37");">
                                                @req.Status
                                            </span>
                                        </div>
                                        <div class="col-md-6">
                                            <small class="text-muted tracking-widest d-block text-uppercase" style="font-size: 0.55rem;">Pickup Coordinates</small>
                                            <div class="text-white-50 small mt-1 text-truncate">@req.PickupAddress</div>
                                        </div>
                                        <div class="col-md-6">
                                            <small class="text-muted tracking-widest d-block text-uppercase" style="font-size: 0.55rem;">Target Destination Address</small>
                                            <div class="text-white-50 small mt-1 text-truncate">@req.DropoffAddress</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .tracking-widest {
        letter-spacing: 0.12em;
    }

    .tracking-wider {
        letter-spacing: 0.08em;
    }

    .text-gold {
        color: #d4af37 !important;
    }

    .animate-fade-in {
        animation: detailsFadeIn 0.25s ease-in-out forwards;
    }

    @@keyframes detailsFadeIn {
        from {
            opacity: 0;
            transform: translateY(4px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>