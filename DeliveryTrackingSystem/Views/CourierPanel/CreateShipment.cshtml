@model Cargobell.Shared.ViewModels.CreateShipmentViewModel
@{
    Layout = "_CourierLayout";
    ViewData["Title"] = "Rapid In-Take";
}

<div class="terminal-fade-in container-fluid">
    <div class="mb-5 border-start border-gold ps-4">
        <h4 class="text-secondary small mb-1 uppercase-tracking">Asset In-Take</h4>
        <h2 class="text-gold fw-bold mb-0">RAPID MANIFEST GENERATOR</h2>
    </div>

    <form asp-action="CreateShipment" method="post" class="terminal-card p-5 shadow-lg">
        @Html.AntiForgeryToken()
         <div asp-validation-summary="All" class="text-danger fw-bold mb-4 font-monospace p-3 bg-black border border-danger rounded small"></div>
        <input type="hidden" asp-for="SenderId" id="senderId" />
        <input type="hidden" asp-for="ReceiverId" id="receiverId" />
        <input type="hidden" asp-for="DeliveryRouteId" id="finalRouteId" />

        <div class="row g-5">
            <div class="col-md-6 border-end border-secondary">
                <h6 class="text-gold uppercase-tracking mb-4"><i class="bi bi-person-up me-2"></i> Originator</h6>

                <div class="mb-3">
                    <label class="text-muted small fw-bold mb-2">PHONE LOOKUP</label>
                    <div class="input-group">
                        <input type="text" asp-for="SenderPhone" id="senderPhone" class="form-control bg-black text-white border-gold font-monospace" placeholder="Search phone...">
                        <button type="button" class="btn btn-outline-gold" onclick="lookupUser('sender')">FETCH</button>
                    </div>
                </div>

                <div id="senderDetails" class="p-3 bg-soft-black border border-success rounded d-none mb-3">
                    <span class="text-success small uppercase-tracking">Verified Account Found</span>
                    <h5 id="senderDisplayName" class="text-white mb-0 mt-1"></h5>
                </div>

                <div id="senderManual">
                    <label class="text-muted small fw-bold mb-2">MANUAL NAME (GUEST)</label>
                    <input type="text" asp-for="SenderManualName" id="senderManualName" class="form-control bg-transparent text-white border-secondary">
                </div>
            </div>

            <div class="col-md-6">
                <h6 class="text-gold uppercase-tracking mb-4"><i class="bi bi-person-down me-2"></i> Destination Account</h6>

                <div class="mb-3">
                    <label class="text-muted small fw-bold mb-2">PHONE LOOKUP</label>
                    <div class="input-group">
                        <input type="text" asp-for="ReceiverPhone" id="receiverPhone" class="form-control bg-black text-white border-gold font-monospace" placeholder="Search phone...">
                        <button type="button" class="btn btn-outline-gold" onclick="lookupUser('receiver')">FETCH</button>
                    </div>
                </div>

                <div id="receiverDetails" class="p-3 bg-soft-black border border-success rounded d-none mb-3">
                    <span class="text-success small uppercase-tracking">Verified Account Found</span>
                    <h5 id="receiverDisplayName" class="text-white mb-0 mt-1"></h5>
                </div>

                <div id="receiverManual">
                    <label class="text-muted small fw-bold mb-2">MANUAL NAME (GUEST)</label>
                    <input type="text" asp-for="ReceiverManualName" id="receiverManualName" class="form-control bg-transparent text-white border-secondary">
                </div>
            </div>

            <hr class="border-secondary my-5">

            <div class="col-md-12">
                <div class="row g-4">
                    <div class="col-md-3">
                        <label class="text-gold small fw-bold mb-2">ORIGIN HUB</label>
                        <select id="startOffice" class="form-select bg-black text-white border-secondary">
                            @foreach (var office in (IEnumerable<Cargobell.Shared.Models.Office>)ViewBag.Offices)
                            {
                                <option value="@office.OfficeId">@office.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="text-gold small fw-bold mb-2">DESTINATION TERMINAL TYPE</label>
                        <select asp-for="DestinationType" id="destinationType" class="form-select bg-dark text-white border-secondary">
                            <option value="Hub">Corporate Office Hub</option>
                            <option value="Manual">Manual Street Address</option>
                        </select>

                        <div id="hubSelectContainer" class="mt-3">
                            <label class="text-muted small mb-1">SELECT OFFICE HUB</label>
                            <select asp-for="EndOfficeId" id="endOffice" class="form-select bg-black text-white border-secondary">
                                <option value="">-- SELECT TARGET HUB --</option>
                                @foreach (var office in (IEnumerable<Cargobell.Shared.Models.Office>)ViewBag.Offices)
                                {
                                    <option value="@office.OfficeId">@office.Name</option>
                                }
                            </select>
                        </div>

                        <div id="addressInputContainer" class="mt-3 d-none">
                            <label class="text-muted small mb-1">ENTER MANUAL ADDRESS</label>
                            <input type="text" asp-for="ManualDestinationAddress" id="manualAddress" class="form-control bg-black text-white border-secondary" placeholder="123 Logistics Way, City">
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label class="text-gold small fw-bold mb-2">DESTINATION REGIONAL ZONE</label>
                        <select asp-for="DestinationZone" id="calcDest" class="form-select bg-dark text-white border-secondary">
                            <option value="1">Domestic (x1.0)</option>
                            <option value="2.5">International (EU) (x2.5)</option>
                            <option value="5.0">International (Global) (x5.0)</option>
                        </select>

                        <label class="text-gold small fw-bold mb-2 mt-3">PACKAGE VOLUMETRIC SIZE</label>
                        <select asp-for="PackageType" id="calcSize" class="form-select bg-dark text-white border-secondary">
                            <option value="5">Document Envelope (€5)</option>
                            <option value="15">Small Parcel (< 2kg) (€15)</option>
                            <option value="35">Standard Box (< 10kg) (€35)</option>
                            <option value="70">Heavy Freight (< 30kg) (€70)</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="text-gold small fw-bold mb-2">CALCULATED SHIPPING COST</label>
                        <div class="input-group mb-3">
                            <span class="input-group-text bg-dark border-gold text-gold">€</span>
                            <input type="number" step="0.01" asp-for="ShippingCost" id="shippingCostField" class="form-control bg-black text-white border-gold font-monospace" readonly />
                        </div>

                        <label class="text-gold small fw-bold mb-2">COLLECTION (COD)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-white">€</span>
                            <input type="number" step="0.01" asp-for="CodAmount" class="form-control bg-black text-white border-secondary font-monospace">
                        </div>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="IsCashOnDelivery" id="isCod">
                            <label class="form-check-label text-muted small" for="isCod">Active COD Collection</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-12 mt-4">
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" asp-for="IsFragile" id="fragile">
                    <label class="form-check-label text-danger small fw-bold" for="fragile">FRAGILE CARGO HANDLING</label>
                </div>
                <label class="text-muted small fw-bold mb-2">MANIFEST NOTES</label>
                <textarea asp-for="Notes" class="form-control bg-transparent text-white border-secondary" rows="2"></textarea>
            </div>
        </div>

        <button type="submit" class="btn btn-gold w-100 mt-5 py-3 fw-bold uppercase-tracking">AUTHORIZE SHIPMENT</button>
    </form>
</div>

@section Scripts {
    <script>
        function lookupUser(prefix) {
            let phoneInput = $(`#${prefix}Phone`).val();
            let detailsContainer = $(`#${prefix}Details`);
            let manualContainer = $(`#${prefix}Manual`);
            let hiddenIdInput = $(`#${prefix}Id`);
            let manualNameInput = $(`#${prefix}ManualName`);

            if (phoneInput.length >= 6) {
                // Clear any existing dynamically injected lookup lists first
                $(`#${prefix}PickerList`).remove();

                $.get('/CourierPanel/GetUserByPhone', { phone: phoneInput }, function (users) {
                    if (users && users.length > 0) {
                        if (users.length === 1) {
                            // Perfect unique match scenario: Auto-select immediately
                            let singleUser = users[0];
                            detailsContainer.removeClass('d-none');
                            $(`#${prefix}DisplayName`).text(singleUser.firstName + " " + singleUser.lastName + " (" + singleUser.phoneNumber + ")");
                            hiddenIdInput.val(singleUser.id);
                            $(`#${prefix}Phone`).val(singleUser.phoneNumber); // Standardize phone input layout
                            manualContainer.addClass('d-none');
                            manualNameInput.val('');
                        } else {
                            // Conflict Scenario: Multiple regional accounts discovered. Build selection grid
                            let pickerHtml = `<div id="${prefix}PickerList" class="p-3 my-2 bg-black border border-warning rounded shadow-lg animate-fade-in">
                                                <span class="text-warning small uppercase-tracking fw-bold d-block mb-2">
                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> AMBIGUOUS CORRELATION: SELECT ACCOUNT
                                                </span>`;
                            
                            users.forEach(function(u) {
                                pickerHtml += `<button type="button" class="btn btn-sm btn-outline-light d-block w-100 text-start my-1 p-2 font-monospace" 
                                                    onclick="selectPickerUser('${prefix}', '${u.id}', '${u.firstName} ${u.lastName}', '${u.phoneNumber}')">
                                                    <i class="bi bi-person-check-fill text-gold me-2"></i> ${u.firstName} ${u.lastName} <span class="text-muted">(${u.phoneNumber})</span>
                                                </button>`;
                            });
                            
                            pickerHtml += `</div>`;
                            
                            // Insert the picker view list directly below the targeting Input Group UI
                            $(`#${prefix}Phone`).closest('.input-group').after(pickerHtml);
                        }
                    } else {
                        // Complete Guest Fallback State
                        detailsContainer.addClass('d-none');
                        hiddenIdInput.val('');
                        manualContainer.removeClass('d-none');
                        alert("No registered database account matched. Reverting parameters to manual entry.");
                    }
                });
            }
        }

        // Executed instantly when a courier confirms one of the candidate users
        function selectPickerUser(prefix, userId, fullName, standardizedPhone) {
            $(`#${prefix}Id`).val(userId);
            $(`#${prefix}Phone`).val(standardizedPhone);
            
            $(`#${prefix}Details`).removeClass('d-none');
            $(`#${prefix}DisplayName`).text(fullName + " (" + standardizedPhone + ")");
            
            $(`#${prefix}Manual`).addClass('d-none');
            $(`#${prefix}ManualName`).val('');
            
            // Clean up visual selection layout structures
            $(`#${prefix}PickerList`).remove();
        }

        // Handle Delivery Option Target Toggling
        $('#destinationType').on('change', function() {
            if ($(this).val() === 'Hub') {
                $('#hubSelectContainer').removeClass('d-none');
                $('#addressInputContainer').addClass('d-none');
                $('#manualAddress').val('');
            } else {
                $('#hubSelectContainer').addClass('d-none');
                $('#addressInputContainer').removeClass('d-none');
                $('#endOffice').val('');
            }
            calculateLiveTariff();
        });

        // Compute Live Matrix Tariff Pricing
        function calculateLiveTariff() {
            let baseSizePrice = parseFloat($('#calcSize').val()) || 0;
            let zoneMultiplier = parseFloat($('#calcDest').val()) || 1.0;
            let finalCost = baseSizePrice * zoneMultiplier;
            
            $('#shippingCostField').val(finalCost.toFixed(2));
        }

        $('#calcSize, #calcDest').on('change', function() {
            calculateLiveTariff();
        });

        $(document).ready(function() {
            calculateLiveTariff();
        });
    </script>
}