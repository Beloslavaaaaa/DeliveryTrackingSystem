@model Cargobell.Shared.Models.Shipment
@{
    Layout = "_CourierLayout";
    ViewData["Title"] = "New Manifest";
}

<div class="mb-5">
    <h2 class="text-gold fw-bold mb-1">RAPID IN-TAKE</h2>
    <p class="text-secondary small text-uppercase">Initialize Logistics Manifest</p>
</div>

<div class="row">
    <div class="col-xl-8">
        <div class="terminal-border p-4">
            <form asp-action="CreateShipment" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="text-gold small fw-bold mb-2">SENDER</label>
                        <select asp-for="SenderId" class="form-select bg-black text-white border-secondary py-2">
                            <option value="">Select Origin...</option>
                            @foreach (var user in ViewBag.Users)
                            {
                                <option value="@user.Id">@user.FirstName @user.LastName</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="text-gold small fw-bold mb-2">RECEIVER</label>
                        <select asp-for="ReceiverId" class="form-select bg-black text-white border-secondary py-2">
                            <option value="">Select Destination Entity...</option>
                            @foreach (var user in ViewBag.Users)
                            {
                                <option value="@user.Id" selected="@(user.Id == ViewBag.PrefillId ? "selected" : null)">
                                    @user.FirstName @user.LastName (@user.Email)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-12">
                        <label class="text-gold small fw-bold mb-2">LOGISTICS ROUTE</label>
                        <select asp-for="DeliveryRouteId" class="form-select bg-black text-white border-secondary py-2">
                            @foreach (var route in ViewBag.Routes)
                            {
                                <option value="@route.DeliveryRouteId">@route.StartLocation → @route.EndLocation (@route.Price.ToString("C"))</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="text-gold small fw-bold mb-2">SETTLEMENT AMOUNT (COD)</label>
                        <input asp-for="CodAmount" type="number" step="0.01" class="form-control bg-transparent text-white border-secondary py-2" placeholder="0.00" />
                    </div>

                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="IsCashOnDelivery" class="form-check-input" type="checkbox">
                            <label class="form-check-label text-white ms-2">Enable COD Protocol</label>
                        </div>
                    </div>
                </div>

                <div class="mt-5 border-top border-dark pt-4">
                    <button type="submit" class="btn btn-gold px-5 py-3 fw-bold text-uppercase w-100">Authorize Shipment</button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="terminal-border p-4 h-100">
            <h6 class="text-gold fw-bold mb-4">QUICK REGISTRATION</h6>
            <p class="text-secondary small mb-4">If the entity is not in the system, register them now:</p>

            <div id="quickRegForm">
                <input type="text" id="regFirst" class="form-control bg-transparent text-white border-secondary mb-2" placeholder="First Name">
                <input type="text" id="regLast" class="form-control bg-transparent text-white border-secondary mb-2" placeholder="Last Name">
                <input type="email" id="regEmail" class="form-control bg-transparent text-white border-secondary mb-2" placeholder="Email Address">
                <input type="text" id="regPhone" class="form-control bg-transparent text-white border-secondary mb-3" placeholder="Phone Number">
                <button type="button" onclick="quickRegister()" class="btn btn-outline-gold w-100 fw-bold">REGISTER ENTITY</button>
            </div>
            <div id="regSuccess" class="alert alert-success mt-3 d-none small">Entity successfully registered.</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function quickRegister() {
            var data = {
                firstName: $('#regFirst').val(),
                lastName: $('#regLast').val(),
                email: $('#regEmail').val(),
                phone: $('#regPhone').val()
            };
            $.post('/Courier/Portal/QuickRegister', data, function(res) {
                if(res.success) {
                    $('#regSuccess').removeClass('d-none');
                    var newOpt = new Option(res.fullName, res.userId);
                    $('select[name="SenderId"]').append(newOpt);
                    $('select[name="ReceiverId"]').append(new Option(res.fullName, res.userId));
                }
            });
        }
    </script>
}