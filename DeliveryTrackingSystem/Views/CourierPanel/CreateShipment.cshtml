@model Cargobell.Shared.Models.Shipment

<form asp-action="CreateShipment" method="post" class="terminal-border p-4">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <div class="col-md-6">
            <label class="text-gold small fw-bold mb-2">SENDER</label>
            <select asp-for="SenderId" id="senderSelect" class="form-select bg-black text-white border-secondary" required>
                @foreach (var user in ViewBag.Users)
                {
                    <option value="@user.Id">@user.FirstName @user.LastName</option>
                }
            </select>
        </div>

        <div class="col-md-6">
            <label class="text-gold small fw-bold mb-2">RECEIVER</label>
            <select asp-for="ReceiverId" id="receiverSelect" class="form-select bg-black text-white border-secondary" required>
                @foreach (var user in ViewBag.Users)
                {
                    <option value="@user.Id" selected="@(user.Id == ViewBag.PrefillId ? "selected" : null)">
                        @user.FirstName @user.LastName
                    </option>
                }
            </select>
        </div>

        <div class="col-md-12">
            <label class="text-gold small fw-bold mb-2">DELIVERY ROUTE</label>
            <select asp-for="DeliveryRouteId" class="form-select bg-black text-white border-secondary" required>
                @foreach (var route in ViewBag.Routes)
                {
                    <option value="@route.DeliveryRouteId">@route.StartLocation to @route.EndLocation (@route.Price.ToString("C"))</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label class="text-gold small fw-bold mb-2">COD AMOUNT</label>
            <input asp-for="CodAmount" type="number" step="0.01" class="form-control bg-transparent text-white border-secondary" />
        </div>

        <div class="col-md-8 d-flex align-items-end gap-4">
            <div class="form-check form-switch mb-2">
                <input asp-for="IsCashOnDelivery" class="form-check-input" type="checkbox">
                <label class="form-check-label text-white ms-2">CASH ON DELIVERY</label>
            </div>
            <div class="form-check form-switch mb-2">
                <input name="IsFragile" class="form-check-input" type="checkbox" value="true">
                <label class="form-check-label text-danger ms-2 fw-bold">FRAGILE CARGO</label>
            </div>
        </div>

        <div class="col-md-12">
            <label class="text-gold small fw-bold mb-2">ADDITIONAL LOGISTICS NOTES</label>
            <textarea name="Notes" class="form-control bg-transparent text-white border-secondary" rows="2"></textarea>
        </div>
    </div>

    <button type="submit" class="btn btn-gold w-100 mt-4 py-3 fw-bold">AUTHORIZE SHIPMENT</button>
</form>