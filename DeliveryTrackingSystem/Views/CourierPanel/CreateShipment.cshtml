@model Cargobell.Shared.Models.Shipment
@{
    Layout = "_CourierLayout";
    ViewData["Title"] = "New Manifest";
}

<div class="mb-5">
    <h2 class="text-gold fw-bold mb-1">RAPID IN-TAKE</h2>
    <p class="text-secondary small text-uppercase">Input Entity Phone Number to Begin</p>
</div>

<form asp-action="CreateShipment" method="post" class="terminal-border p-5">
    @Html.AntiForgeryToken()

    <div class="row g-5">
        @* SENDER SECTION *@
        <div class="col-md-6 border-end border-secondary">
            <h5 class="text-gold mb-4"><i class="bi bi-box-arrow-up me-2"></i>SENDER DATA</h5>

            <label class="text-muted small fw-bold">PHONE NUMBER</label>
            <input type="text" id="senderPhone" name="SenderPhone" class="form-control bg-black text-white border-gold mb-3" placeholder="Search phone..." required autocomplete="off">

            <div id="senderDetails" class="mt-3 p-3 bg-dark rounded d-none">
                <p class="text-success small mb-1"><i class="bi bi-check-circle me-1"></i> ENTITY RECOGNIZED</p>
                <h6 id="senderDisplayName" class="text-white fw-bold mb-0"></h6>
                <input type="hidden" asp-for="SenderId" id="senderId">
            </div>

            <div id="senderManual" class="mt-3 d-none">
                <p class="text-warning small mb-1"><i class="bi bi-exclamation-triangle me-1"></i> NEW ENTITY - MANUAL ENTRY REQUIRED</p>
                <label class="text-muted small fw-bold">FULL NAME</label>
                <input type="text" id="senderManualName" name="SenderManualName" class="form-control bg-transparent text-white border-secondary mb-2" placeholder="Enter sender's full name">
            </div>
        </div>

        @* RECEIVER SECTION *@
        <div class="col-md-6">
            <h5 class="text-gold mb-4"><i class="bi bi-box-arrow-in-down me-2"></i>RECEIVER DATA</h5>

            <label class="text-muted small fw-bold">PHONE NUMBER</label>
            <input type="text" id="receiverPhone" name="ReceiverPhone" class="form-control bg-black text-white border-gold mb-3" placeholder="Search phone..." required autocomplete="off">

            <div id="receiverDetails" class="mt-3 p-3 bg-dark rounded d-none">
                <p class="text-success small mb-1"><i class="bi bi-check-circle me-1"></i> ENTITY RECOGNIZED</p>
                <h6 id="receiverDisplayName" class="text-white fw-bold mb-0"></h6>
                <input type="hidden" asp-for="ReceiverId" id="receiverId">
            </div>

            <div id="receiverManual" class="mt-3 d-none">
                <p class="text-warning small mb-1"><i class="bi bi-exclamation-triangle me-1"></i> NEW ENTITY - MANUAL ENTRY REQUIRED</p>
                <label class="text-muted small fw-bold">FULL NAME</label>
                <input type="text" id="receiverManualName" name="ReceiverManualName" class="form-control bg-transparent text-white border-secondary mb-2" placeholder="Enter receiver's full name">
            </div>
        </div>

        <hr class="border-secondary">

        <div class="col-md-12 mt-2">
            <label class="text-gold small fw-bold mb-2">LOGISTICS ROUTE</label>
            <select asp-for="DeliveryRouteId" class="form-select bg-black text-white border-secondary py-3" required>
                @foreach (var route in (IEnumerable<Cargobell.Shared.Models.DeliveryRoute>)ViewBag.Routes)
                {
                    <option value="@route.DeliveryRouteId">@route.StartLocation → @route.EndLocation (@route.Price.ToString("C"))</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label class="text-gold small fw-bold mb-2">COD AMOUNT</label>
            <input asp-for="CodAmount" type="number" step="0.01" class="form-control bg-transparent text-white border-secondary py-2" placeholder="0.00">
        </div>

        <div class="col-md-8 d-flex align-items-end gap-4 pb-1">
            <div class="form-check form-switch">
                <input asp-for="IsCashOnDelivery" class="form-check-input" type="checkbox">
                <label class="form-check-label text-white ms-2">COD PROTOCOL</label>
            </div>
            <div class="form-check form-switch">
                <input name="IsFragile" class="form-check-input" type="checkbox" value="true">
                <label class="form-check-label text-danger ms-2 fw-bold">FRAGILE CARGO</label>
            </div>
        </div>

        <div class="col-md-12 mt-3">
            <label class="text-gold small fw-bold mb-2">MANIFEST NOTES</label>
            <textarea asp-for="Notes" class="form-control bg-transparent text-white border-secondary" rows="2"></textarea>
        </div>
    </div>

    <button type="submit" class="btn btn-gold w-100 mt-5 py-4 fw-bold text-uppercase fs-5">Authorize Manifest</button>
</form>

@section Scripts {
    <script>
        $(document).ready(function() {
            function lookupUser(phone, prefix) {
                if (phone.length >= 8) { // Optimized for standard phone lengths
                    $.get('/CourierPanel/GetUserByPhone', { phone: phone }, function(user) {
                        if (user) {
                            $(`#${prefix}Details`).removeClass('d-none');
                            $(`#${prefix}Manual`).addClass('d-none');
                            $(`#${prefix}ManualName`).val('').prop('required', false);
                            $(`#${prefix}DisplayName`).text(`${user.firstName} ${user.lastName} [${user.email}]`);
                            $(`#${prefix}Id`).val(user.id);
                        } else {
                            $(`#${prefix}Details`).addClass('d-none');
                            $(`#${prefix}Manual`).removeClass('d-none');
                            $(`#${prefix}ManualName`).prop('required', true);
                            $(`#${prefix}Id`).val('');
                        }
                    });
                } else {
                    $(`#${prefix}Details`).addClass('d-none');
                    $(`#${prefix}Manual`).addClass('d-none');
                    $(`#${prefix}ManualName`).prop('required', false);
                }
            }

            // Trigger on Enter key
            $('#senderPhone, #receiverPhone').on('keypress', function(e) {
                if (e.which == 13) {
                    e.preventDefault();
                    let prefix = this.id === 'senderPhone' ? 'sender' : 'receiver';
                    lookupUser($(this).val(), prefix);
                }
            });

            // Fallback: lookup when courier stops typing
            let timeout = null;
            $('#senderPhone, #receiverPhone').on('keyup', function() {
                clearTimeout(timeout);
                let prefix = this.id === 'senderPhone' ? 'sender' : 'receiver';
                timeout = setTimeout(() => lookupUser($(this).val(), prefix), 800);
            });
        });
    </script>
}