@model IEnumerable<Cargobell.Shared.Models.Shipment>
@{
    Layout = "_CourierLayout"; ViewData["Title"] = "Package History";
}

<div class="mb-5 d-flex justify-content-between align-items-end">
    <div>
        <h2 class="text-gold fw-bold mb-1">ARCHIVED MANIFESTS</h2>
        <p class="text-secondary small text-uppercase">Complete Historical Record</p>
    </div>
    <form method="get" class="d-flex gap-2 w-50">
        <input type="text" name="searchTerm" class="form-control bg-black text-white border-secondary" placeholder="SEARCH HISTORY...">
        <button type="submit" class="btn btn-outline-gold">FILTER</button>
    </form>
</div>

<div class="table-responsive terminal-border">
    <table class="table table-dark mb-0">
        <thead class="text-gold small uppercase">
            <tr>
                <th>CODE</th>
                <th>DELIVERED</th>
                <th>SENDER</th>
                <th>RECEIVER</th>
                <th>PRICE</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="border-secondary">
                    <td class="text-gold fw-bold">@item.TrackingCode</td>
                    <td class="text-muted small">@item.DeliveredDate?.ToString("g")</td>
                    <td class="small">@item.Sender?.PhoneNumber</td>
                    <td class="small">@item.Receiver?.PhoneNumber</td>
                    <td class="text-success fw-bold">$@item.CodAmount</td>
                </tr>
            }
        </tbody>
    </table>
</div>