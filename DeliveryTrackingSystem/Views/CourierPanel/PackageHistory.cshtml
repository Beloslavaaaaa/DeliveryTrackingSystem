@model IEnumerable<Cargobell.Shared.Models.Shipment>
@{
    Layout = "_CourierLayout";
    ViewData["Title"] = "Archived Manifests";
}

<style>
    .terminal-table-container {
        border: 1px solid #262626;
        background-color: #0a0a0a;
    }

    .table-hover-terminal tbody tr {
        transition: background-color 0.2s ease, border-color 0.2s ease;
        border-bottom: 1px solid #1a1a1a;
    }

        .table-hover-terminal tbody tr:hover {
            background-color: #121212 !important;
            border-color: #D4AF37;
        }

    .search-input-terminal {
        border: 1px solid #262626 !important;
    }

        .search-input-terminal:focus {
            border-color: #D4AF37 !important;
            box-shadow: 0 0 10px rgba(212, 175, 55, 0.1) !important;
        }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-5 border-start border-warning ps-4">
        <div>
            <h2 class="text-white fw-bold mb-0 tracking-tight text-uppercase">Manifest Ledger</h2>
            <span class="text-muted small font-monospace text-uppercase" style="letter-spacing: 1px;">Archived historical registers & settled freight</span>
        </div>
        <div class="text-end font-monospace">
            <span class="text-secondary small d-block">TOTAL ARCHIVED</span>
            <h3 class="text-gold fw-bold mb-0">@Model.Count()</h3>
        </div>
    </div>

    <div class="mb-4">
        <form method="get" action="/CourierPanel/History" class="d-flex gap-2" style="max-width: 500px;">
            <input type="text" name="searchTerm" class="form-control bg-black text-white search-input-terminal rounded-1 font-monospace py-2"
                   placeholder="[ QUERY NAME, PHONE OR TRK... ]" value="@Context.Request.Query["searchTerm"]">
            <button type="submit" class="btn btn-outline-warning px-4 rounded-1 font-monospace fw-bold">QUERY</button>
        </form>
    </div>

    <div class="terminal-table-container overflow-hidden rounded-1">
        <table class="table table-dark table-hover-terminal align-middle mb-0">
            <thead>
                <tr class="text-uppercase font-monospace small text-muted bg-black" style="border-bottom: 2px solid #262626;">
                    <th class="ps-4 py-3">TRACKING ID</th>
                    <th class="py-3">RECIPIENT ENTITY</th>
                    <th class="py-3">SETTLED DATE</th>
                    <th class="py-3">TERMINAL HUB</th>
                    <th class="text-end pe-4 py-3">COD SETTLED</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted font-monospace small">
                            [ NO HISTORICAL MANIFEST RECORDS INITIALIZED MATCHING CRITERIA ]
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    string rName = "Custom Delivery Entity";
                    string rPhone = "N/A";

                    if (item.Receiver != null)
                    {
                        rName = $"{item.Receiver.FirstName} {item.Receiver.LastName}";
                        rPhone = item.Receiver.PhoneNumber ?? "N/A";
                    }
                    else if (!string.IsNullOrEmpty(item.Notes) && item.Notes.Contains("DROP-OFF RECIPIENT:"))
                    {
                        try
                        {
                            var firstSplit = item.Notes.Split(new string[] { "DROP-OFF RECIPIENT: " }, StringSplitOptions.None)[1];
                            var secondSplit = firstSplit.Split(new string[] { ")." }, StringSplitOptions.None)[0];
                            var details = secondSplit.Split('(');
                            rName = details[0].Trim();
                            rPhone = details[1].Trim();
                        }
                        catch { }
                    }

                    <tr style="cursor: pointer;" onclick="window.location.href='/CourierPanel/ManifestDetails/@item.ShipmentId'">
                        <td class="ps-4 text-gold font-monospace fw-bold">@item.TrackingCode</td>
                        <td>
                            <div class="text-white fw-bold">@rName</div>
                            <div class="text-muted small font-monospace">@rPhone</div>
                        </td>
                        <td class="text-muted font-monospace">@(item.DeliveredDate?.ToString("dd MMM yyyy") ?? "UNSETTLED")</td>
                        <td class="text-white-50">@(item.DeliveryRoute?.EndLocation ?? "Distributed Processing Node")</td>
                        <td class="text-end pe-4 text-success fw-bold font-monospace">€@item.CodAmount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>