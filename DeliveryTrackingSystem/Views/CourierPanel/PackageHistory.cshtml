@model IEnumerable<Cargobell.Shared.Models.Shipment>
@{
    Layout = "_CourierLayout";
    ViewData["Title"] = "Archived Manifests";
}

<div class="container-fluid py-4 animate-fade-in text-white" style="background-color: #050505; font-family: 'Courier New', Courier, monospace;">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end pb-3 mb-4 border-bottom border-secondary">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="spinner-grow spinner-grow-sm text-gold" role="status"></span>
                <h6 class="text-muted small mb-0 text-uppercase tracking-wider">Logistics Command System</h6>
            </div>
            <h1 class="text-gold fw-bold tracking-tight mb-0" style="color: #d4af37; text-shadow: 0 0 10px rgba(212,175,55,0.2);">MANIFEST ARCHIVE LEDGER</h1>
        </div>
        <div class="mt-3 mt-md-0 font-monospace text-md-end">
            <small class="text-muted tracking-widest d-block text-uppercase" style="font-size: 0.6rem;">Total Settled Freight</small>
            <h3 class="text-gold fw-bold mb-0" style="color: #d4af37;">@Model.Count() <span class="text-muted" style="font-size: 0.8rem;">NODES</span></h3>
        </div>
    </div>

    <div class="card bg-black border-secondary rounded-0 mb-5" style="background: #0a0a0a; border-style: dashed !important;">
        <div class="card-body p-4">
            <form method="get" action="/CourierPanel/History">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label text-gold small font-monospace tracking-widest text-uppercase mb-2 d-flex justify-content-between">
                            <span><i class="bi bi-search me-2"></i>Archive Query Input</span>
                            <span class="text-muted text-none lowercase font-monospace" style="font-size:0.65rem;">[Autofocused for hardware laser scanners]</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-black text-gold border-secondary rounded-0">
                                <i class="bi bi-qr-code-scan mx-1"></i>
                            </span>

                            <input type="text" name="searchTerm" id="archiveSearchInput" autofocus
                                   class="form-control bg-black text-white border-secondary rounded-0 font-monospace py-3 ps-3"
                                   placeholder="[SCAN BARCODE] OR TYPE NAME, PHONE, OR ADDRESS TARGETS..."
                                   value="@Context.Request.Query["searchTerm"]"
                                   style="box-shadow: none;">

                            @if (!string.IsNullOrEmpty(Context.Request.Query["searchTerm"]))
                            {
                                <a href="/CourierPanel/History" class="btn btn-outline-danger border-secondary rounded-0 text-uppercase d-flex align-items-center px-3 font-monospace fw-bold" style="letter-spacing: 1px;">
                                    <i class="bi bi-x-lg me-1"></i> Clear
                                </a>
                            }

                            <button type="submit" class="btn btn-gold text-black uppercase-tracking px-4 fw-bold rounded-0 text-uppercase" style="background-color: #d4af37;">
                                EXECUTE
                            </button>
                        </div>
                    </div>

                    <div class="col-12 d-flex flex-wrap gap-2 mt-2 text-muted font-monospace" style="font-size: 0.7rem;">
                        <div class="px-2 py-1 bg-black border border-secondary text-uppercase"><i class="bi bi-hash text-gold me-1"></i> Tracking Codes</div>
                        <div class="px-2 py-1 bg-black border border-secondary text-uppercase"><i class="bi bi-person text-gold me-1"></i> Historical Clients</div>
                        <div class="px-2 py-1 bg-black border border-secondary text-uppercase"><i class="bi bi-telephone text-gold me-1"></i> Contact Numbers</div>
                        <div class="px-2 py-1 bg-black border border-secondary text-uppercase"><i class="bi bi-geo-alt text-gold me-1"></i> Terminal Hub Sectors</div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="text-center py-5 border border-dashed border-secondary" style="background-color: #0a0a0a;">
                    <i class="bi bi-exclamation-triangle text-muted fs-2 d-block mb-3"></i>
                    <h5 class="text-secondary tracking-widest text-uppercase">NO HISTORICAL MANIFEST RECORDS INITIALIZED</h5>
                    <p class="text-muted small mb-0">No archived records matched your search parameters or ledger matrix is empty.</p>
                </div>
            </div>
        }

        @foreach (var item in Model)
        {
            string rName = "Custom Delivery Entity";
            string rPhone = "N/A";

            if (item.Receiver != null)
            {
                rName = $"{item.Receiver.FirstName} {item.Receiver.LastName}";
                rPhone = item.Receiver.PhoneNumber ?? "N/A";
            }
            else if (!string.IsNullOrEmpty(item.Notes) && item.Notes.Contains("DROP-OFF RECIPIENT:"))
            {
                try
                {
                    var firstSplit = item.Notes.Split(new string[] { "DROP-OFF RECIPIENT: " }, StringSplitOptions.None)[1];
                    var secondSplit = firstSplit.Split(new string[] { ")." }, StringSplitOptions.None)[0];
                    var details = secondSplit.Split('(');
                    rName = details[0].Trim();
                    rPhone = details[1].Trim();
                }
                catch { }
            }

            <div class="col-xl-4 col-md-6">
                <div class="card h-100 bg-black rounded-0 transition-all border-secondary position-relative"
                     style="border: 1px solid #222; background: #0d0d0d; transition: transform 0.2s, border-color 0.2s;"
                     onmouseover="this.style.borderColor='#d4af37'" onmouseout="this.style.borderColor='#222'">

                    <div class="card-header bg-black border-bottom border-secondary d-flex justify-content-between align-items-center py-3 px-4 rounded-0">
                        <a href="/CourierPanel/ManifestDetails/@item.ShipmentId" class="text-decoration-none fw-bold text-gold tracking-wider">
                            <i class="bi bi-hash text-muted me-1"></i>@item.TrackingCode
                        </a>
                        <span class="badge border bg-soft-black px-3 py-1 tracking-widest text-uppercase"
                              style="font-size: 0.65rem; color: #888; border-color: #444; background-color: rgba(255,255,255,0.02);">
                            SETTLED
                        </span>
                    </div>

                    <div class="card-body p-4">
                        <div class="d-flex flex-column gap-3">

                            <div>
                                <small class="text-muted tracking-widest d-block text-uppercase" style="font-size: 0.65rem;">Historical Recipient Entity</small>
                                <div class="text-white fw-bold fs-5 mt-1">@rName</div>
                                <div class="text-secondary font-monospace small"><i class="bi bi-telephone me-2 text-muted"></i>@rPhone</div>
                            </div>

                            <hr class="border-secondary my-1">

                            <div class="row g-2 font-monospace">
                                <div class="col-6 border-end border-secondary">
                                    <small class="text-muted tracking-widest d-block text-uppercase" style="font-size: 0.6rem;">Terminal Hub Node</small>
                                    <div class="text-white small fw-bold mt-1 text-truncate">@(item.DeliveryRoute?.EndLocation ?? "Distributed Processing Node")</div>
                                </div>
                                <div class="col-6 ps-3">
                                    <small class="text-muted tracking-widest d-block text-uppercase" style="font-size: 0.6rem;">Settled Ledger</small>
                                    <div class="text-success fw-bold mt-1">€@item.CodAmount.ToString("N2")</div>
                                    <span class="text-secondary d-block" style="font-size: 0.55rem;">FUNDS CAPTURED</span>
                                </div>
                            </div>

                            <hr class="border-secondary my-1">

                            <div class="d-flex justify-content-between align-items-center font-monospace">
                                <div>
                                    <small class="text-muted tracking-widest d-block text-uppercase" style="font-size: 0.6rem;">Archive Execution Timestamp</small>
                                    <span class="text-white-50 small"><i class="bi bi-calendar-check me-2 text-gold"></i>@(item.DeliveredDate?.ToString("dd MMM yyyy") ?? "UNSETTLED")</span>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="card-footer bg-black border-top border-secondary p-3 d-flex gap-2 rounded-0">
                        <a href="/CourierPanel/ManifestDetails/@item.ShipmentId" class="btn btn-gold text-black font-monospace tracking-widest fw-bold w-100 rounded-0 text-uppercase py-2 text-center text-decoration-none" style="background-color: #d4af37; border: none; font-size: 0.8rem;">
                            <i class="bi bi-folder2-open me-2"></i>Inspect Ledger Record
                        </a>
                    </div>

                </div>
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        var input = document.getElementById("archiveSearchInput");
        if (input) {
            input.focus();
            var val = input.value;
            input.value = '';
            input.value = val;
        }
    });
</script>

<style>
    .tracking-widest {
        letter-spacing: 0.12em;
    }

    .tracking-wider {
        letter-spacing: 0.08em;
    }

    .bg-soft-black {
        background-color: #0d0d0d;
    }

    .text-gold {
        color: #d4af37 !important;
    }

    .btn-gold:hover {
        background-color: #bfa030 !important;
        color: black !important;
    }

    .btn-outline-gold:hover {
        background-color: rgba(212,175,55,0.1) !important;
        color: #d4af37 !important;
    }
</style>