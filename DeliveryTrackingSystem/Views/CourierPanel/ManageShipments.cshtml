@model IEnumerable<Cargobell.Shared.Models.Shipment>
@{
    Layout = "_CourierLayout"; ViewData["Title"] = "Cargo Management";
}

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h2 class="text-gold fw-bold mb-1">LOGISTICS CONTROL</h2>
        <p class="text-secondary small text-uppercase">Sector: @Context.Request.Query["filter"] Manifests</p>
    </div>
    <div class="btn-group border border-gold rounded">
        <a href="/CourierPanel/Shipments?filter=available" class="btn @(Context.Request.Query["filter"] == "available" ? "btn-gold" : "btn-outline-gold")">AVAILABLE</a>
        <a href="/CourierPanel/Shipments?filter=active" class="btn @(Context.Request.Query["filter"] == "active" ? "btn-gold" : "btn-outline-gold")">MY MANIFEST</a>
    </div>
</div>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-xl-4 col-md-6">
            <div class="terminal-border p-4 h-100">
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-gold fw-bold small">#@item.TrackingCode</span>
                    <span class="badge border border-secondary text-secondary">@item.Status?.Name</span>
                </div>
                <h5 class="text-white mb-3">@item.DeliveryRoute?.StartLocation <i class="bi bi-arrow-right mx-2 text-gold"></i> @item.DeliveryRoute?.EndLocation</h5>
                <div class="d-grid gap-2">
                    @if (item.CourierId == null)
                    {
                        <form action="/CourierPanel/ClaimShipment" method="post">
                            <input type="hidden" name="shipmentId" value="@item.ShipmentId" />
                            <button type="submit" class="btn btn-gold w-100 py-2 fw-bold">CLAIM ASSIGNMENT</button>
                        </form>
                    }
                    else
                    {
                        <div class="dropdown">
                            <button class="btn btn-outline-gold w-100 dropdown-toggle" data-bs-toggle="dropdown">UPDATE STATUS</button>
                            <ul class="dropdown-menu dropdown-menu-dark w-100 border-gold">
                                <li><a class="dropdown-item" href="#" onclick="updateStatus(@item.ShipmentId, 'In Transit')">SET IN TRANSIT</a></li>
                                <li><a class="dropdown-item" href="#" onclick="updateStatus(@item.ShipmentId, 'Out For Delivery')">OUT FOR DELIVERY</a></li>
                                <li><a class="dropdown-item text-success fw-bold" href="#" onclick="updateStatus(@item.ShipmentId, 'Delivered')">MARK DELIVERED</a></li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateStatus(id, status) {
            $.post('/CourierPanel/UpdateStatus', { shipmentId: id, statusName: status }, function() { location.reload(); });
        }
    </script>
}