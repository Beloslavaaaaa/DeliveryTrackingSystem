@model IEnumerable<Cargobell.Shared.Models.ApplicationUser>
@{
    Layout = "_CourierLayout";
    ViewData["Title"] = "Entity Lookup";
}

<div class="mb-5">
    <h2 class="text-gold fw-bold mb-1">ENTITY LOOKUP</h2>
    <p class="text-secondary small text-uppercase">Database Search: Operational Contacts</p>
</div>

<div class="terminal-border p-4 mb-5">
    <form method="get" asp-action="UserDirectory" class="row g-3">
        <div class="col-md-10">
            <input type="text" name="searchTerm" class="form-control bg-transparent text-white border-secondary py-2"
                   placeholder="SEARCH BY NAME OR CONTACT NUMBER..." value="@Context.Request.Query["searchTerm"]" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-gold w-100 py-2 fw-bold">EXECUTE</button>
        </div>
    </form>
</div>

<div class="row g-4">
    @if (Model.Any())
    {
        @foreach (var user in Model)
        {
            <div class="col-xl-4 col-md-6">
                <div class="terminal-border p-4" style="border-left: 3px solid #D4AF37;">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-gold text-black rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width: 45px; height: 45px; font-size: 1.2rem;">
                            @user.FirstName[0]@user.LastName[0]
                        </div>
                        <div>
                            <h6 class="text-white mb-0 text-uppercase fw-bold">@user.FirstName @user.LastName</h6>
                            <span class="text-muted font-monospace" style="font-size: 0.7rem;">ID: @user.Id.Substring(0, 8).ToUpper()</span>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="text-gold small d-block text-uppercase" style="font-size: 0.6rem;">Contact</label>
                        <span class="text-white small"><i class="bi bi-telephone me-2"></i>@user.PhoneNumber</span>
                    </div>

                    <div class="mb-4">
                        <label class="text-gold small d-block text-uppercase" style="font-size: 0.6rem;">Verified Email</label>
                        <span class="text-white small">@user.Email</span>
                    </div>

                    <div class="d-grid">
                        <a asp-action="CreateShipment" asp-route-prefillId="@user.Id" class="btn btn-outline-secondary btn-sm text-uppercase fw-bold" style="font-size: 0.7rem;">
                            Assign New Manifest
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <i class="bi bi-database-exclamation fs-1 text-secondary mb-3 d-block"></i>
            <p class="text-secondary text-uppercase small">No entities matching your query were found in the database.</p>
        </div>
    }
</div>