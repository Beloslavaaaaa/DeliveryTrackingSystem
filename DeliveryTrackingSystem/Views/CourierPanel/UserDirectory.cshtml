@model IEnumerable<DeliveryTrackingSystem.Controllers.UserRequestViewModel>
@{
    Layout = "_CourierLayout"; ViewData["Title"] = "Directory";
}

<div class="mb-5">
    <h2 class="text-gold fw-bold mb-1">ENTITY DIRECTORY</h2>
    <p class="text-secondary small text-uppercase">Search Entities & Monitor Service Requests</p>
</div>

<div class="row g-4">
    @foreach (var vm in Model)
    {
        <div class="col-xl-4 col-md-6">
            <div class="terminal-border p-4" style="border-left: 3px solid #D4AF37;">
                <h6 class="text-white fw-bold text-uppercase mb-1">@vm.User.FirstName @vm.User.LastName</h6>
                <p class="text-muted small mb-3">@vm.User.PhoneNumber</p>

                @if (vm.RequestCount > 0)
                {
                    <a href="/CourierPanel/ViewRequests/@vm.User.Id" class="btn btn-gold w-100 fw-bold">
                        COURIER REQUESTS (@vm.RequestCount)
                    </a>
                }
                else
                {
                    <button class="btn btn-outline-secondary w-100 disabled" style="opacity: 0.4;">
                        COURIER REQUESTS (0)
                    </button>
                }
            </div>
        </div>
    }
</div>