@model IEnumerable<Cargobell.Shared.Models.ApplicationUser>
@{
    Layout = "_CourierLayout";
    ViewData["Title"] = "Entity Database";
}

<div class="mb-5">
    <h2 class="text-gold fw-bold mb-1">ENTITY DATABASE</h2>
    <p class="text-secondary small text-uppercase">Operational Contact Directory</p>
</div>

<div class="terminal-border p-4 mb-5">
    <form method="get" class="row g-3">
        <div class="col-md-10">
            <input type="text" name="searchTerm" class="form-control bg-transparent text-white border-secondary py-2"
                   placeholder="Search by Name or Phone..." value="@Context.Request.Query["searchTerm"]" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-gold w-100 py-2 fw-bold">SEARCH</button>
        </div>
    </form>
</div>

<div class="row g-4">
    @if (Model.Any())
    {
        @foreach (var user in Model)
        {
            <div class="col-xl-4 col-md-6">
                <div class="terminal-border p-4" style="border-left: 3px solid #D4AF37;">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-gold text-black rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width: 45px; height: 45px;">
                            @user.FirstName[0]@user.LastName[0]
                        </div>
                        <div>
                            <h6 class="text-white mb-0 text-uppercase">@user.FirstName @user.LastName</h6>
                            <span class="text-muted small">UID: @user.Id.Substring(0, 8).ToUpper()</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="text-gold small d-block text-uppercase" style="font-size: 0.65rem;">Communication</label>
                        <a href="tel:@user.PhoneNumber" class="text-white text-decoration-none">
                            <i class="bi bi-telephone text-gold me-2"></i> @user.PhoneNumber
                        </a>
                    </div>

                    <div class="mb-4">
                        <label class="text-gold small d-block text-uppercase" style="font-size: 0.65rem;">Verified Email</label>
                        <span class="text-white small">@user.Email</span>
                    </div>

                    <a href="/Courier/Portal/Shipments?filter=active" class="btn btn-outline-secondary btn-sm w-100 text-uppercase" style="font-size: 0.7rem;">
                        View Associated Cargo
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <i class="bi bi-person-x fs-1 text-secondary mb-3 d-block"></i>
            <p class="text-secondary">No matching entities found in your operational sector.</p>
        </div>
    }
</div>