<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Courier Terminal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #050505;
            color: #fff;
            font-family: 'Segoe UI', sans-serif;
        }

        .sidebar {
            width: 280px;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: #000;
            border-right: 1px solid #D4AF37;
            padding: 2rem 1.5rem;
        }

        .main-content {
            margin-left: 280px;
            padding: 3rem;
        }

        .nav-link {
            color: #888;
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
            transition: 0.3s;
        }

            .nav-link:hover, .nav-link.active {
                background: rgba(212, 175, 55, 0.1);
                color: #D4AF37;
            }

            .nav-link i {
                margin-right: 15px;
                font-size: 1.2rem;
            }

        .terminal-border {
            border: 1px solid #333;
            border-radius: 12px;
            background: rgba(20,20,20,0.5);
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="mb-5 text-center">
            <h3 class="text-gold fw-bold mb-0">CARGOBELL</h3>
            <span class="text-secondary small">OPS TERMINAL v3.1</span>
        </div>

        <nav class="nav flex-column">
            <a class="nav-link active" asp-controller="CourierPanel" asp-action="Index">
                <i class="bi bi-speedometer2"></i> Overview
            </a>
            <a class="nav-link" asp-controller="CourierPanel" asp-action="ManageShipments" asp-route-filter="available">
                <i class="bi bi-search"></i> Cargo Board
            </a>
            <a class="nav-link" asp-controller="CourierPanel" asp-action="ManageShipments" asp-route-filter="active">
                <i class="bi bi-box-seam"></i> Active Manifest
            </a>
            <a class="nav-link" asp-controller="CourierPanel" asp-action="UserDirectory">
                <i class="bi bi-people"></i> Entity Lookup
            </a>
            <a class="nav-link" asp-action="Profile" asp-controller="Dashboard">
                <i class="bi bi-person-badge"></i> ID Card
            </a>
            <hr class="border-secondary mt-4" />
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start text-danger">
                    <i class="bi bi-power"></i> System Logoff
                </button>
            </form>
        </nav>
    </div>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>