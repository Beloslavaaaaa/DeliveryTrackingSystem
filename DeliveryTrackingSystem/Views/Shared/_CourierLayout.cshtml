<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cargobell</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            body {
                background: #000 !important;
                color: #fff;
                margin: 0;
                padding: 0;
                height: 100vh;
                overflow: hidden; /* Prevent body scroll */
            }

            /* Fixed Sidebar sizing */
            .sidebar {
                width: 260px;
                background: #000;
                border-right: 1px solid rgba(212, 175, 55, 0.3);
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                z-index: 1000;
                display: flex;
                flex-direction: column;
            }

            /* Main content offset by fixed sidebar width */
            main {
                margin-left: 260px;
                height: 100vh;
                overflow-y: auto; /* Individual scroll for content */
                padding: 40px !important;
                background: radial-gradient(circle at top right, rgba(212, 175, 55, 0.05), transparent);
            }

            .nav-link {
                color: #888;
                font-size: 0.85rem;
                letter-spacing: 1px;
                padding: 12px 25px;
                transition: 0.3s;
                border-left: 3px solid transparent;
            }

                .nav-link:hover, .nav-link.active {
                    color: #D4AF37 !important;
                    background: rgba(212, 175, 55, 0.05);
                    border-left: 3px solid #D4AF37;
                }

            .terminal-border {
                border: 1px solid rgba(255,255,255,0.1);
                background: rgba(15, 15, 15, 0.6);
            }
    </style>
</head>
<body>
    <div class="sidebar py-4">
        <div class="px-4 mb-5">
            <h5 class="text-gold fw-bold mb-0 tracking-tight">CARGOBELL</h5>
            <span class="text-muted" style="font-size: 0.6rem; letter-spacing: 2px;">TERMINAL v3.5</span>
        </div>

        <div class="nav flex-column mb-auto">
            @{
                var path = Context.Request.Path.Value ?? "";
            }
            <a class="nav-link @(path == "/CourierPanel" ? "active" : "")" href="/CourierPanel">
                <i class="bi bi-cpu me-3"></i> DASHBOARD
            </a>
            <a class="nav-link @(path.Contains("/Active") ? "active" : "")" href="/CourierPanel/Active">
                <i class="bi bi-box-seam me-3"></i> ACTIVE CARGO
            </a>
            <a class="nav-link @(path.Contains("/History") ? "active" : "")" href="/CourierPanel/History">
                <i class="bi bi-archive me-3"></i> LOGS
            </a>
            <a class="nav-link @(path.Contains("/Users") ? "active" : "")" href="/CourierPanel/Users">
                <i class="bi bi-people me-3"></i> DIRECTORY
            </a>
        </div>

        <div class="px-4 mt-auto mb-4">
            <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                <button type="submit" class="btn btn-outline-danger w-100 btn-sm uppercase-tracking">Terminate</button>
            </form>
        </div>
    </div>

    <main>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert bg-black text-success border-success small mb-4">
                <i class="bi bi-check-all me-2"></i> @TempData["SuccessMessage"]
            </div>
        }
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>