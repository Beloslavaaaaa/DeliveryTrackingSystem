<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cargobell Terminal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #050505; color: #e0e0e0; font-family: 'Segoe UI', monospace; }
        .sidebar { min-height: 100vh; border-right: 1px solid #D4AF37; background: #0a0a0a; position: fixed; }
        .nav-link { color: #888; border-left: 3px solid transparent; transition: 0.3s; margin-bottom: 5px; text-transform: uppercase; font-size: 0.85rem; }
        .nav-link:hover, .nav-link.active { color: #D4AF37; background: rgba(212, 175, 55, 0.05); border-left: 3px solid #D4AF37; }
        .terminal-border { border: 1px solid #333; border-radius: 0; }
        .text-gold { color: #D4AF37; }
        .btn-gold { background: #D4AF37; color: black; border-radius: 0; font-weight: bold; }
        main { margin-left: 16.666667%; }
        .animate-fade-in { animation: fadeIn 0.5s; }
        @Html.Raw("@keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }")
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 sidebar py-4">
                <div class="px-3 mb-5">
                    <h4 class="text-gold fw-bold mb-0">CARGOBELL</h4>
                    <span class="small text-secondary">COURIER TERMINAL v3.1</span>
                </div>
                <div class="nav flex-column">
                    <a class="nav-link py-3" href="/CourierPanel">DASHBOARD</a>
                    <a class="nav-link py-3" href="/CourierPanel/CreateShipment">NEW MANIFEST</a>
                    <a class="nav-link py-3" href="/CourierPanel/Shipments?filter=active">ACTIVE CARGO</a>
                    <a class="nav-link py-3" href="/CourierPanel/Shipments?filter=available">FIND PICKUPS</a>
                    <a class="nav-link py-3" href="/CourierPanel/Users">DIRECTORY</a>
                    <hr class="border-secondary mx-3">
                    <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                        <button type="submit" class="nav-link py-3 bg-transparent border-0 w-100 text-start text-danger">LOGOUT</button>
                    </form>
                </div>
            </nav>

            <main class="col-md-10 px-md-5 py-5">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="position-fixed top-0 end-0 p-4" style="z-index: 1050;">
                        <div class="terminal-border bg-black p-3 animate-fade-in" style="border-left: 5px solid #28a745;">
                            <strong class="text-success d-block small fw-bold">SYSTEM CONFIRMATION</strong>
                            <span class="text-white small">@TempData["SuccessMessage"]</span>
                        </div>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        setTimeout(function() { $('.animate-fade-in').fadeOut(); }, 4000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>