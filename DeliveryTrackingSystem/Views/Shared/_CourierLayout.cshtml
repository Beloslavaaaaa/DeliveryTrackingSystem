<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cargobell</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #050505;
            color: #e0e0e0;
            font-family: 'Courier New', monospace;
            font-size: 0.85rem;
        }

        /* Fixed Sidebar with Luxury Gold Border */
        .sidebar {
            min-height: 100vh;
            border-right: 1px solid #D4AF37;
            background: #0a0a0a;
            position: fixed;
            width: 190px;
            z-index: 100;
        }

        .nav-link {
            color: #888;
            border-left: 3px solid transparent;
            text-transform: uppercase;
            font-size: 0.75rem;
            padding: 12px 20px;
            letter-spacing: 1px;
        }

            .nav-link:hover, .nav-link.active {
                color: #D4AF37;
                border-left: 3px solid #D4AF37;
                background: #111;
                text-shadow: 0 0 5px rgba(212, 175, 55, 0.3);
            }

        /* Main Content Spacing */
        main {
            margin-left: 190px;
            padding: 30px 40px !important;
        }

        .terminal-border {
            border: 1px solid #333;
        }

        .text-gold {
            color: #D4AF37;
        }

        /* Luxury Gold Button */
        .btn-gold {
            background: #D4AF37;
            color: #000;
            border-radius: 0;
            font-weight: bold;
            border: 1px solid #D4AF37;
            font-size: 0.75rem;
            transition: 0.3s;
        }

            .btn-gold:hover {
                background: #b8962d;
                color: #000;
            }

        /* Compact Table Styling */
        .table-luxury {
            background: #0a0a0a;
            border: 1px solid #333;
            font-size: 0.8rem;
        }

            .table-luxury thead {
                background: #111;
                color: #D4AF37;
            }

            .table-luxury td {
                padding: 10px 15px !important;
                border-bottom: 1px solid #222;
            }

        h2 {
            font-size: 1.6rem !important;
            letter-spacing: 2px;
        }
    </style>
</head>
<body>
    <div class="container-fluid p-0">
        <div class="row g-0">
            <nav class="sidebar py-4 d-flex flex-column">
                <div class="px-3 mb-4">
                    <h5 class="text-gold fw-bold mb-0">CARGOBELL</h5>
                    <span class="small text-muted" style="font-size: 0.65rem;">TERMINAL v3.5</span>
                </div>

                <div class="nav flex-column mb-auto">
                    @{
                        var currentPath = Context.Request.Path.Value ?? "";
                    }

                    <a class="nav-link @(currentPath == "/CourierPanel" ? "active" : "")" href="/CourierPanel">
                        <i class="bi bi-speedometer2 me-2"></i> DASHBOARD
                    </a>

                    <a class="nav-link @(currentPath.Contains("/Active") ? "active" : "")" href="/CourierPanel/Active">
                        <i class="bi bi-box-seam me-2"></i> ACTIVE CARGO
                    </a>

                    <a class="nav-link @(currentPath.Contains("/History") ? "active" : "")" href="/CourierPanel/History">
                        <i class="bi bi-clock-history me-2"></i> HISTORY
                    </a>

                    <a class="nav-link @(currentPath.Contains("/Users") ? "active" : "")" href="/CourierPanel/Users">
                        <i class="bi bi-people me-2"></i> DIRECTORY
                    </a>
                </div>

                <div class="px-3 mt-auto mb-4">
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="btn btn-outline-danger w-100 btn-sm text-uppercase fw-bold" style="font-size: 0.65rem;">Terminate Session</button>
                    </form>
                </div>
            </nav>

            <main>
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success bg-black text-success border-success mb-4">
                        SYSTEM: @TempData["SuccessMessage"]
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>