<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cargobell</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root {
            --gold-gradient: linear-gradient(45deg, #BF953F, #FCF6BA, #B38728, #FBF5B7, #AA771C);
            --gold-solid: #D4AF37;
            --rich-black: #050505;
        }

        body {
            background-color: var(--rich-black) !important;
            color: #ffffff !important;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.85rem; /* Shrunk for panel fit */
        }

        /* Fixed Sidebar adjusted to luxury style */
        .sidebar {
            width: 200px;
            position: fixed;
            height: 100vh;
            background: #000;
            border-right: 1px solid var(--gold-solid);
            z-index: 1000;
        }

        main {
            margin-left: 200px;
            padding: 30px !important;
        }

        .text-gold {
            background: var(--gold-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: bold;
            font-family: 'Cinzel', serif;
        }

        /* Table Styling */
        .table-luxury {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px;
        }

            .table-luxury th {
                color: var(--gold-solid);
                text-transform: uppercase;
                font-size: 0.75rem;
                letter-spacing: 1px;
                border-bottom: 1px solid #333;
                padding: 10px;
            }

            .table-luxury td {
                background: rgba(255,255,255,0.03);
                border-top: 1px solid #222;
                border-bottom: 1px solid #222;
                padding: 12px;
            }

        .btn-gold {
            background: var(--gold-gradient) !important;
            color: #000 !important;
            font-weight: 700;
            border: none;
            transition: 0.4s;
            font-family: 'Cinzel', serif;
            font-size: 0.75rem;
            border-radius: 2px;
        }

        .btn-outline-gold {
            border: 1px solid var(--gold-solid) !important;
            color: var(--gold-solid) !important;
            background: transparent;
            font-family: 'Cinzel', serif;
            font-size: 0.7rem;
            border-radius: 2px;
        }

            .btn-gold:hover, .btn-outline-gold:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
            }

        .request-box {
            border-left: 2px solid var(--gold-solid);
            background: rgba(212, 175, 55, 0.05);
            margin-bottom: 5px;
            padding: 8px 12px;
        }
    </style>
</head>
<body>
    <div class="container-fluid p-0">
        <div class="row g-0">
            <nav class="sidebar py-4 d-flex flex-column">
                <div class="px-3 mb-4">
                    <h5 class="text-gold fw-bold mb-0">CARGOBELL</h5>
                    <span class="small text-muted" style="font-size: 0.65rem;">TERMINAL v3.5</span>
                </div>

                <div class="nav flex-column mb-auto">
                    @{
                        var currentPath = Context.Request.Path.Value ?? "";
                    }

                    <a class="nav-link @(currentPath == "/CourierPanel" ? "active" : "")" href="/CourierPanel">
                        <i class="bi bi-speedometer2 me-2"></i> DASHBOARD
                    </a>

                    <a class="nav-link @(currentPath.Contains("/Active") ? "active" : "")" href="/CourierPanel/Active">
                        <i class="bi bi-box-seam me-2"></i> ACTIVE CARGO
                    </a>

                    <a class="nav-link @(currentPath.Contains("/History") ? "active" : "")" href="/CourierPanel/History">
                        <i class="bi bi-clock-history me-2"></i> HISTORY
                    </a>

                    <a class="nav-link @(currentPath.Contains("/Users") ? "active" : "")" href="/CourierPanel/Users">
                        <i class="bi bi-people me-2"></i> DIRECTORY
                    </a>
                </div>

                <div class="px-3 mt-auto mb-4">
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="btn btn-outline-danger w-100 btn-sm text-uppercase fw-bold" style="font-size: 0.65rem;">Terminate Session</button>
                    </form>
                </div>
            </nav>

            <main>
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success bg-black text-success border-success mb-4">
                        SYSTEM: @TempData["SuccessMessage"]
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>