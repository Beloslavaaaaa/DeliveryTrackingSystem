<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cargobell</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root {
            --gold-gradient: linear-gradient(135deg, #D4AF37 0%, #f7ef8a 50%, #ae8625 100%);
            --glass-bg: rgba(10, 10, 10, 0.9);
            --border-gold: rgba(212, 175, 55, 0.4);
        }

        body {
            background: #000 !important;
            font-family: 'Montserrat', sans-serif;
            color: #fff;
            overflow-x: hidden;
            height: 100vh; /* Lock height to the screen */
        }

        /* Scaling Sidebar */
        .sidebar {
            width: 15vw; /* Scales with screen width */
            min-width: 180px;
            background: #000;
            border-right: 1px solid var(--border-gold);
            position: fixed;
            height: 100vh;
            z-index: 1000;
        }

        /* Scaling Main Content */
        main {
            margin-left: 15vw;
            padding: 3vh 3vw !important; /* Vertical and horizontal scaling padding */
            height: 100vh;
            overflow-y: auto;
        }

        /* The "Elite" Card - Sizing Adjusted */
        .node-card {
            background: var(--glass-bg);
            border: 1px solid var(--border-gold);
            padding: 1.5rem;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: 间-between;
        }

        /* Floating Gold Button */
        .btn-create-floating {
            position: fixed;
            top: 3vh;
            right: 3vw;
            background: var(--gold-gradient);
            color: #000 !important;
            font-family: 'Cinzel', serif;
            font-weight: 900;
            padding: 10px 25px;
            text-decoration: none;
            z-index: 1100;
            box-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
            clip-path: polygon(5% 0, 100% 0, 95% 100%, 0 100%);
        }

        .text-gold {
            background: var(--gold-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-family: 'Cinzel', serif;
        }

        /* High-Density Grid */
        .row-cols-custom {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.5rem;
        }
    </style>
</head>
<body>
    <div class="container-fluid p-0">
        <div class="row g-0">
            <nav class="sidebar py-4 d-flex flex-column">
                <div class="px-3 mb-4">
                    <h5 class="text-gold fw-bold mb-0">CARGOBELL</h5>
                    <span class="small text-muted" style="font-size: 0.65rem;">TERMINAL v3.5</span>
                </div>

                <div class="nav flex-column mb-auto">
                    @{
                        var currentPath = Context.Request.Path.Value ?? "";
                    }

                    <a class="nav-link @(currentPath == "/CourierPanel" ? "active" : "")" href="/CourierPanel">
                        <i class="bi bi-speedometer2 me-2"></i> DASHBOARD
                    </a>

                    <a class="nav-link @(currentPath.Contains("/Active") ? "active" : "")" href="/CourierPanel/Active">
                        <i class="bi bi-box-seam me-2"></i> ACTIVE CARGO
                    </a>

                    <a class="nav-link @(currentPath.Contains("/History") ? "active" : "")" href="/CourierPanel/History">
                        <i class="bi bi-clock-history me-2"></i> HISTORY
                    </a>

                    <a class="nav-link @(currentPath.Contains("/Users") ? "active" : "")" href="/CourierPanel/Users">
                        <i class="bi bi-people me-2"></i> DIRECTORY
                    </a>
                </div>

                <div class="px-3 mt-auto mb-4">
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="btn btn-outline-danger w-100 btn-sm text-uppercase fw-bold" style="font-size: 0.65rem;">Terminate Session</button>
                    </form>
                </div>
            </nav>

            <main>
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success bg-black text-success border-success mb-4">
                        SYSTEM: @TempData["SuccessMessage"]
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>