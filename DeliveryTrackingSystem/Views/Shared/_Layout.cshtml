<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cargobell</title>

    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        :root {
            --gold-gradient: linear-gradient(45deg, #BF953F, #FCF6BA, #B38728, #FBF5B7, #AA771C);
            --gold-solid: #D4AF37;
            --rich-black: #050505;
        }

        body { 
            background-color: var(--rich-black) !important; 
            color: #ffffff !important; 
            font-family: 'Montserrat', sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main { flex: 1; }

        .navbar { 
            background-color: #000000 !important; 
            border-bottom: 1px solid var(--gold-solid); 
            padding: 1rem 0;
        }

        .text-gold { 
            background: var(--gold-gradient); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent; 
            font-weight: bold; 
        }

        .nav-link { 
            color: #ffffff !important; 
            font-weight: 600 !important;
            transition: 0.3s;
        }

        .nav-link:hover { color: var(--gold-solid) !important; }

        .btn-gold {
            background: var(--gold-gradient) !important;
            color: #000 !important;
            font-weight: 700;
            border: none;
            position: relative;
            overflow: hidden;
            transition: 0.4s;
            font-family: 'Cinzel', serif;
        }

        .btn-outline-gold {
            border: 1px solid var(--gold-solid) !important;
            color: var(--gold-solid) !important;
            background: transparent;
            position: relative;
            overflow: hidden;
            transition: 0.4s;
            font-family: 'Cinzel', serif;
        }

        .btn-gold:hover, .btn-outline-gold:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 20px rgba(212, 175, 55, 0.4);
        }

        .search-container {
            border: 1px solid #333;
            border-radius: 4px;
            background: rgba(255,255,255,0.05);
            padding: 2px 10px;
            transition: 0.3s;
        }

        .search-container:focus-within {
            border-color: var(--gold-solid);
        }

        .search-input {
            background: transparent;
            border: none;
            color: white;
            font-size: 0.8rem;
            outline: none;
            width: 150px;
        }

        input.form-control:focus {
            background-color: rgba(255, 255, 255, 0.05) !important;
            border-color: var(--gold-solid) !important;
            color: white !important;
            box-shadow: 0 0 8px rgba(212, 175, 55, 0.2);
        }

        input:-webkit-autofill,
        input:-webkit-autofill:hover, 
        input:-webkit-autofill:focus {
            -webkit-text-fill-color: white !important;
            -webkit-box-shadow: 0 0 0px 1000px #050505 inset !important;
            transition: background-color 5000s ease-in-out 0s;
        }

        footer { 
            border-top: 1px solid #222; 
            margin-top: 5rem; 
            padding: 3rem 0; 
            background: #000; 
        }

        .footer-link {
            color: #888;
            text-decoration: none;
            font-size: 0.8rem;
            letter-spacing: 1px;
            transition: 0.3s;
        }

        .footer-link:hover {
            color: var(--gold-solid);
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow mb-5">
            <div class="container">
                <a class="navbar-brand fs-2 text-gold" asp-controller="Home" asp-action="Index">CARGOBELL</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity.IsAuthenticated)
                        {
                                <li class="nav-item">
                                    <a class="nav-link text-uppercase small text-gold" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-uppercase small" asp-controller="Shipments" asp-action="History">Manifests</a>
                                </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity.IsAuthenticated)
                        {
                                <form class="search-container d-flex align-items-center" asp-controller="Shipments" asp-action="Details" method="get">
                                    <input type="text" name="trackingCode" class="search-input" placeholder="TRACK ORDER CODE">
                                    <button type="submit" class="btn btn-link text-gold p-0 ms-2"><i class="bi bi-search"></i></button>
                                </form>
                        }

                        <ul class="navbar-nav align-items-center">
                            @if (User.Identity.IsAuthenticated)
                            {
                                    <li class="nav-item me-3"><span class="nav-link small text-secondary">@User.Identity.Name</span></li>
                                    <li class="nav-item">
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="nav-link btn btn-link text-uppercase small text-white border-0" style="text-decoration:none; cursor: pointer;">Exit</button>
                                        </form>
                                    </li>
                            }
                            else
                            {
                                    <li class="nav-item"><a class="nav-link text-uppercase small me-3" asp-area="" asp-controller="Account" asp-action="Login">Sign In</a></li>
                                    <li class="nav-item"><a class="btn btn-gold px-4 py-2" asp-area="" asp-controller="Account" asp-action="Register">Register</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container">
        @RenderBody()
    </main>

    <footer class="text-center">
        <div class="container">
            <div class="mb-4">
                <p class="text-gold mb-1" style="letter-spacing: 8px; font-weight: 700;">CARGOBELL</p>
                <p class="text-secondary small">PREMIUM LOGISTICS TERMINAL</p>
            </div>

            <div class="d-flex justify-content-center gap-4 mb-4">
                <a asp-controller="Home" asp-action="Contact" class="footer-link">CONTACTS</a>
                <a asp-controller="Home" asp-action="Pricing" class="footer-link">PRICING</a>
                <a asp-controller="Home" asp-action="Privacy" class="footer-link">PRIVACY</a>
            </div>

            <div class="pt-3 border-top border-dark">
                <p class="text-muted" style="font-size: 0.7rem;">&copy; 2026 CARGOBELL GLOBAL. ALL RIGHTS RESERVED.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>