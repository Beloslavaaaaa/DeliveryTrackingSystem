<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cargobell</title>

    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        :root {
            --gold-gradient: linear-gradient(45deg, #BF953F, #FCF6BA, #B38728, #FBF5B7, #AA771C);
            --gold-solid: #D4AF37;
            --rich-black: #0A0A0A;
            --soft-black: #161616;
        }

        body { 
            background-color: var(--rich-black); 
            color: #E0E0E0; 
            font-family: 'Montserrat', sans-serif; 
            letter-spacing: 0.5px;
        }

        h1, h2, h3, .navbar-brand { 
            font-family: 'Cinzel', serif; 
            letter-spacing: 3px;
        }

        .navbar { 
            background-color: rgba(0,0,0,0.95) !important; 
            border-bottom: 1px solid var(--gold-solid);
            padding: 1.5rem 0;
        }

        .text-gold { 
            background: var(--gold-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: bold;
        }

        .btn-gold { 
            background: var(--gold-gradient);
            color: #000 !important;
            font-weight: 700;
            border: none;
            text-transform: uppercase;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            font-family: 'Cinzel', serif;
        }

        .btn-gold:hover { 
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(212, 175, 55, 0.4);
        }

        .card { 
            background-color: var(--soft-black); 
            border: 1px solid #2a2a2a; 
            transition: border 0.4s ease;
        }

        .card:hover {
            border-color: var(--gold-solid);
        }

        footer { 
            background: #000;
            border-top: 1px solid #222;
            padding: 3rem 0;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-lg mb-5">
            <div class="container">
                <a class="navbar-brand fs-2 text-gold" asp-controller="Home" asp-action="Index">CARGOBELL</a>

                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                                <li class="nav-item">
                                    <a class="nav-link text-uppercase small pt-3" asp-controller="Shipments" asp-action="History">Portfolio</a>
                                </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                                <li class="nav-item"><span class="nav-link text-gold px-4">@User.Identity.Name</span></li>
                                <li class="nav-item"><form asp-area="Identity" asp-page="/Account/Logout"><button class="btn btn-link nav-link text-uppercase small">Exit</button></form></li>
                        }
                        else
                        {
                                <li class="nav-item"><a class="nav-link text-uppercase small pt-3" asp-area="Identity" asp-page="/Account/Login">Sign In</a></li>
                                <li class="nav-item"><a class="btn btn-gold ms-lg-4 px-4 py-2" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container pb-5">
        @RenderBody()
    </main>

    <footer>
        <div class="container text-center">
            <h2 class="text-gold fs-5 mb-3">CARGOBELL</h2>
            <p class="small text-secondary fw-light" style="letter-spacing: 5px;">YOUR CARGO ON THE BELL</p>
            <div class="mt-4">
                <a href="#" class="text-secondary mx-2"><i class="bi bi-instagram"></i></a>
                <a href="#" class="text-secondary mx-2"><i class="bi bi-linkedin"></i></a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>