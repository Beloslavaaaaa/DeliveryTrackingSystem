<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cargobell</title>

    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        :root {
            --gold-gradient: linear-gradient(45deg, #BF953F, #FCF6BA, #B38728, #FBF5B7, #AA771C);
            --gold-solid: #D4AF37;
            --rich-black: #0A0A0A;
            --soft-black: #161616;
        }
        body { background-color: var(--rich-black); color: #E0E0E0; font-family: 'Montserrat', sans-serif; }
        h1, h2, h3, .navbar-brand { font-family: 'Cinzel', serif; letter-spacing: 3px; }
        .navbar { background-color: #000 !important; border-bottom: 1px solid var(--gold-solid); padding: 1rem 0; }
        .text-gold { background: var(--gold-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: bold; }
        .btn-gold { background: var(--gold-gradient); color: #000 !important; font-weight: 700; border: none; font-family: 'Cinzel', serif; text-transform: uppercase; }
        .nav-link { text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; color: #fff !important; }
        .nav-link:hover { color: var(--gold-solid) !important; }
        footer { border-top: 1px solid #222; margin-top: 5rem; padding: 2rem 0; background: #000; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow mb-5">
            <div class="container">
                <a class="navbar-brand fs-2 text-gold" asp-controller="Home" asp-action="Index">CARGOBELL</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Pricing">Pricing</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact Us</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        @if (User.Identity.IsAuthenticated)
                        {
                                <li class="nav-item"><a class="nav-link text-gold" asp-controller="Shipments" asp-action="History">My History</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                                <li class="nav-item"><span class="nav-link">@User.Identity.Name</span></li>
                                <li class="nav-item">
                                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                                        <button type="submit" class="nav-link btn btn-link">Logout</button>
                                    </form>
                                </li>
                        }
                        else
                        {
                                <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Sign In</a></li>
                                <li class="nav-item"><a class="btn btn-gold ms-lg-3 px-4" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container">
        @RenderBody()
    </main>

    <footer class="text-center">
        <div class="container">
            <p class="text-gold small mb-1" style="letter-spacing: 5px;">CARGOBELL</p>
            <p class="text-secondary small">YOUR CARGO ON THE BELL</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>