<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cargobell</title>

    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        :root {
            --gold-gradient: linear-gradient(45deg, #BF953F, #FCF6BA, #B38728, #FBF5B7, #AA771C);
            --gold-solid: #D4AF37;
            --rich-black: #050505;
        }

        body { 
            background-color: var(--rich-black) !important; 
            color: #ffffff !important; 
            font-family: 'Montserrat', sans-serif;
        }

        .navbar { 
            background-color: #000000 !important; 
            border-bottom: 1px solid var(--gold-solid); 
            padding: 1rem 0;
        }

        .text-gold { 
            background: var(--gold-gradient); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent; 
            font-weight: bold; 
        }

        .nav-link { 
            color: #ffffff !important; 
            font-weight: 600 !important;
            transition: 0.3s;
        }

        .nav-link:hover { color: var(--gold-solid) !important; }

        /* LUXURY SHINE BUTTONS */
        .btn-gold {
            background: var(--gold-gradient) !important;
            color: #000 !important;
            font-weight: 700;
            border: none;
            position: relative;
            overflow: hidden;
            transition: 0.4s;
            font-family: 'Cinzel', serif;
        }

        .btn-outline-gold {
            border: 1px solid var(--gold-solid) !important;
            color: var(--gold-solid) !important;
            background: transparent;
            position: relative;
            overflow: hidden;
            transition: 0.4s;
            font-family: 'Cinzel', serif;
        }

        .btn-gold:hover, .btn-outline-gold:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 20px rgba(212, 175, 55, 0.4);
        }

        .btn-gold::after, .btn-outline-gold::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -150%;
            width: 50%;
            height: 200%;
            background: rgba(255, 255, 255, 0.4);
            transform: rotate(30deg);
            transition: 0.6s ease-in-out;
        }

        .btn-gold:hover::after, .btn-outline-gold:hover::after {
            left: 150%;
        }
        /* Styling the Inputs for Identity Pages */
input.form-control:focus {
    background-color: rgba(255, 255, 255, 0.05) !important;
    border-color: var(--gold-solid) !important;
    color: white !important;
    box-shadow: 0 0 8px rgba(212, 175, 55, 0.2);
}

/* Chrome/Edge autocomplete background fix */
input:-webkit-autofill,
input:-webkit-autofill:hover, 
input:-webkit-autofill:focus {
    -webkit-text-fill-color: white !important;
    -webkit-box-shadow: 0 0 0px 1000px #050505 inset !important;
    transition: background-color 5000s ease-in-out 0s;
}

        footer { border-top: 1px solid #222; margin-top: 5rem; padding: 2rem 0; background: #000; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow mb-5">
            <div class="container">
                <a class="navbar-brand fs-2 text-gold" asp-controller="Home" asp-action="Index">CARGOBELL</a>
                <div class="ms-auto">
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                                <li class="nav-item me-3"><span class="nav-link">@User.Identity.Name</span></li>
                                <li class="nav-item">
                                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Dashboard", new { area = "" })" method="post">
                                        <button type="submit" class="nav-link btn btn-link text-uppercase small text-white" style="text-decoration:none;">Exit</button>
                                    </form>
                                </li>
                        }
                        else
                        {
                                <li class="nav-item"><a class="nav-link text-uppercase small me-3" asp-area="Identity" asp-page="/Account/Login">Sign In</a></li>
                                <li class="nav-item"><a class="btn btn-gold px-4 py-2" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container">
        @RenderBody()
    </main>

    <footer class="text-center">
        <div class="container">
            <p class="text-gold small mb-1" style="letter-spacing: 5px;">CARGOBELL</p>
            <p class="text-secondary small">YOUR CARGO ON THE BELL</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>