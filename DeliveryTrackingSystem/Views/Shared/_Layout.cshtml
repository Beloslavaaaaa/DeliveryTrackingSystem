@using Microsoft.AspNetCore.Identity
@using Cargobell.Shared.Models
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = User.Identity.IsAuthenticated ? await UserManager.GetUserAsync(User) : null;
    bool isApproved = currentUser?.IsApproved ?? false;
    bool isCourier = currentUser != null && await UserManager.IsInRoleAsync(currentUser, "Courier");
    bool canAccessSystem = isApproved || isCourier;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cargobell</title>

    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        :root {
            --gold-solid: #D4AF37;
            --gold-gradient: linear-gradient(45deg, #BF953F, #FCF6BA, #B38728, #FBF5B7, #AA771C);
        }
        body {
            background-color: #050505 !important;
            color: #ffffff !important;
            font-family: 'Montserrat', sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .navbar {
            background-color: #000000 !important;
            border-bottom: 1px solid var(--gold-solid);
            padding: 1rem 0;
        }
        .text-gold {
            background: var(--gold-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: bold;
        }
        .nav-link { color: #ffffff !important; text-transform: uppercase; font-size: 0.8rem; font-weight: 600; }
        .nav-link:hover { color: var(--gold-solid) !important; }
        .btn-gold {
            background: var(--gold-gradient) !important;
            color: #000 !important;
            font-weight: 700;
            border: none;
            font-family: 'Cinzel', serif;
        }
        .search-container {
            border: 1px solid #333;
            border-radius: 4px;
            background: rgba(255,255,255,0.05);
            padding: 2px 10px;
        }
        .search-input {
            background: transparent;
            border: none;
            color: white;
            font-size: 0.8rem;
            outline: none;
            width: 150px;
        }
        main { flex: 1; padding-top: 2rem; }
        footer { border-top: 1px solid #222; padding: 3rem 0; margin-top: 5rem; }
        .footer-link {
            color: #888;
            text-decoration: none;
            font-size: 0.8rem;
            letter-spacing: 1px;
            transition: 0.3s;
        }
        .footer-link:hover { color: var(--gold-solid); }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow mb-5">
            <div class="container">
                @if (!User.Identity.IsAuthenticated)
                {
                    <a class="navbar-brand fs-2 text-gold" asp-controller="Home" asp-action="Index">CARGOBELL</a>
                }
                else
                {
                    <span class="navbar-brand fs-2 text-gold">CARGOBELL</span>
                }

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity.IsAuthenticated && canAccessSystem)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Shipments" asp-action="History">Manifests</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity.IsAuthenticated && canAccessSystem)
                        {
                            <form class="search-container d-flex align-items-center" asp-controller="Shipments" asp-action="Details" method="get">
                                <input type="text" name="trackingCode" class="search-input" placeholder="TRACK ORDER CODE">
                                <button type="submit" class="btn btn-link text-gold p-0 ms-2"><i class="bi bi-search"></i></button>
                            </form>
                        }

                        <ul class="navbar-nav align-items-center">
                            @if (User.Identity.IsAuthenticated)
                            {
                                var headerName = currentUser?.FirstName ?? User.Identity.Name?.Split('@')[0];

                                <li class="nav-item me-3">
                                    <a class="nav-link small text-gold d-flex align-items-center gap-2" asp-controller="Dashboard" asp-action="Profile">
                                        <i class="bi bi-person-circle"></i>
                                        <span class="text-uppercase">@headerName</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="nav-link btn btn-link text-uppercase small text-white border-0" style="text-decoration:none;">Exit</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link text-uppercase small me-3" asp-controller="Account" asp-action="Login">Sign In</a></li>
                                <li class="nav-item"><a class="btn btn-gold px-4 py-2" asp-controller="Account" asp-action="Register">Register</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container">
        @RenderBody()
    </main>

    <footer class="text-center">
        <div class="container">
            <div class="mb-4">
                <p class="text-gold mb-1" style="letter-spacing: 5px; font-weight: 700;">CARGOBELL</p>
            </div>
            
            @if (User.Identity.IsAuthenticated)
            {
                <div class="d-flex justify-content-center gap-4 mb-4">
                    <a asp-controller="Home" asp-action="Contact" class="footer-link">CONTACT US</a>
                    <a asp-controller="Home" asp-action="Pricing" class="footer-link">PRICING</a>
                    <a asp-controller="Home" asp-action="Privacy" class="footer-link">PRIVACY POLICY</a>
                </div>
            }

            <div class="pt-3 border-top border-dark">
                <p class="text-muted mb-0" style="font-size: 0.7rem;">&copy; 2026 CARGOBELL GLOBAL. ALL RIGHTS RESERVED.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>