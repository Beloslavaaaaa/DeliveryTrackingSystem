@using Cargobell.Shared.Helpers
@model Cargobell.Shared.Models.ApplicationUser
@{
    ViewData["Title"] = "Executive Dossier";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="text-center mb-5">
                <h1 class="text-gold fw-bold display-4">EXECUTIVE DOSSIER</h1>
                <p class="text-secondary small text-uppercase" style="letter-spacing: 5px;">ID: @Model.Id.ToString().Substring(0, 8).ToUpper()</p>
            </div>

            <div class="card shadow-lg border-0" style="background: rgba(255,255,255,0.02); backdrop-filter: blur(15px);">
                <div class="card-body p-5">
                    <div class="row g-5">
                        <div class="col-md-6">
                            <label class="text-gold small d-block">FULL NAME</label>
                            <p class="text-white mb-4 fw-bold fs-5">@Model.FirstName @Model.LastName</p>

                            <label class="text-gold small d-block">CITIZENSHIP</label>
                            <p class="text-white mb-4 fs-5">@CountryHelper.GetCitizenship(Model.PhoneNumber)</p>

                            <label class="text-gold small d-block">STATUS</label>
                            <p><span class="badge border border-gold text-gold bg-transparent px-3 py-2">ACTIVE ELITE</span></p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-gold small d-block">CONTACT</label>
                            <p class="text-white mb-4 fs-5">@Model.Email</p>

                            <label class="text-gold small d-block">PHONE</label>
                            <p class="text-white mb-4 fs-5">@Model.PhoneNumber</p>

                            <label class="text-gold small d-block">AGE</label>
                            <p class="text-white mb-4 fs-5">@Model.Age YEARS OLD</p>
                        </div>
                    </div>

                    <div class="mt-5 pt-4 border-top border-dark">
                        <a asp-action="Settings" class="btn btn-gold w-100 py-3 fw-bold">MODIFY ACCOUNT</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>