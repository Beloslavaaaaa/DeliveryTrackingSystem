@model Cargobell.Shared.Models.ApplicationUser
@{
    ViewData["Title"] = "Member Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="text-center mb-5">
                <div class="d-inline-block p-3 rounded-circle mb-3" style="border: 2px solid var(--gold-solid); background: rgba(212, 175, 55, 0.1);">
                    <i class="bi bi-person-badge text-gold" style="font-size: 3rem;"></i>
                </div>
                <h1 class="text-gold fw-bold">MEMBER PROFILE</h1>
                <p class="text-secondary small text-uppercase" style="letter-spacing: 3px;">Cargobell Global Elite</p>
            </div>

            <div class="card shadow-lg" style="background: rgba(255,255,255,0.03); backdrop-filter: blur(10px); border: 1px solid #2a2a2a;">
                <div class="card-body p-5">
                    <div class="row g-4">
                        <div class="col-sm-6">
                            <label class="text-gold small fw-bold text-uppercase">Account ID</label>
                            <p class="text-white border-bottom border-dark pb-2">@Model.Id.ToString().Substring(0, 8)...</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-gold small fw-bold text-uppercase">Email Address</label>
                            <p class="text-white border-bottom border-dark pb-2">@Model.Email</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-gold small fw-bold text-uppercase">Username</label>
                            <p class="text-white border-bottom border-dark pb-2">@Model.UserName</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-gold small fw-bold text-uppercase">Status</label>
                            <p class="text-white border-bottom border-dark pb-2">
                                <span class="badge bg-success" style="background-color: rgba(25, 135, 84, 0.2) !important; color: #75b798; border: 1px solid #75b798;">Verified Client</span>
                            </p>
                        </div>
                    </div>

                    <div class="mt-5 d-flex gap-3">
                        <button class="btn btn-gold flex-grow-1 py-3">Update Info</button>
                        <button class="btn btn-outline-gold flex-grow-1 py-3">Security Settings</button>
                    </div>
                </div>
            </div>

            <div class="mt-4 text-center">
                <p class="text-secondary small">Need to change your tier? <a asp-controller="Home" asp-action="Contact" class="text-gold text-decoration-none">Contact Concierge</a></p>
            </div>
        </div>
    </div>
</div>