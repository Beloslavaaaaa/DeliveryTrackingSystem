@model Cargobell.Shared.Models.ApplicationUser
@{
    ViewData["Title"] = "Account Settings";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg bg-black" style="border: 1px solid #D4AF37;">
                <div class="card-header bg-dark border-bottom border-gold p-4">
                    <h4 class="text-gold mb-0 fw-bold">ACCOUNT MODIFICATION</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="UpdateProfile" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger mb-4 small"></div>

                        <h6 class="text-gold mb-3 border-bottom border-dark pb-2" style="letter-spacing: 2px;">GENERAL INFORMATION</h6>
                        <div class="row g-4 mb-5">
                            <div class="col-md-6">
                                <label class="text-gold small fw-bold">FIRST NAME</label>
                                <input asp-for="FirstName" class="form-control bg-transparent text-white border-secondary py-2"
                                       onkeydown="return /[a-zA-Z\s]/i.test(event.key) || event.key === 'Backspace' || event.key === 'Tab'" />
                            </div>
                            <div class="col-md-6">
                                <label class="text-gold small fw-bold">LAST NAME</label>
                                <input asp-for="LastName" class="form-control bg-transparent text-white border-secondary py-2"
                                       onkeydown="return /[a-zA-Z\s]/i.test(event.key) || event.key === 'Backspace' || event.key === 'Tab'" />
                            </div>
                            <div class="col-md-6">
                                <label class="text-gold small fw-bold">EMAIL ADDRESS</label>
                                <input name="NewEmail" value="@Model.Email" class="form-control bg-transparent text-white border-secondary py-2" />
                            </div>
                            <div class="col-md-6">
                                <label class="text-gold small fw-bold">PHONE NUMBER</label>
                                <input asp-for="PhoneNumber" class="form-control bg-transparent text-white border-secondary py-2"
                                       onkeypress="return (event.charCode >= 48 && event.charCode <= 57) || event.charCode == 43" />
                            </div>
                        </div>

                        <h6 class="text-gold mb-3 border-bottom border-dark pb-2" style="letter-spacing: 2px;">SECURITY PROTOCOL</h6>
                        <div class="row g-4">
                            <div class="col-md-12">
                                <label class="text-gold small fw-bold">CURRENT PASSWORD (REQUIRED TO SAVE CHANGES)</label>
                                <input type="password" name="CurrentPassword" class="form-control bg-transparent text-white border-secondary py-2" required />
                            </div>
                            <div class="col-md-6">
                                <label class="text-gold small fw-bold">NEW PASSWORD (OPTIONAL)</label>
                                <input type="password" name="NewPassword" class="form-control bg-transparent text-white border-secondary py-2" placeholder="Leave blank to keep current" />
                            </div>
                            <div class="col-md-6">
                                <label class="text-gold small fw-bold">CONFIRM NEW PASSWORD</label>
                                <input type="password" name="ConfirmNewPassword" class="form-control bg-transparent text-white border-secondary py-2" />
                            </div>
                        </div>

                        <div class="mt-5 d-flex gap-3">
                            <button type="submit" class="btn btn-gold flex-grow-1 py-3 fw-bold text-uppercase" style="letter-spacing: 2px;">
                                Commit Changes
                            </button>
                            <a asp-action="Profile" class="btn btn-outline-secondary px-4 py-3 text-uppercase small">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>