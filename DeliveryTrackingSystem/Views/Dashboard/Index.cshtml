@model Cargobell.Shared.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Command Center";
}

<div class="container py-4">
    <div class="mb-5 animate-terminal-fade">
        <h4 class="text-secondary small mb-1" style="letter-spacing: 3px;">WELCOME BACK</h4>
        <h1 class="text-gold display-5 fw-bold">GREETINGS, @Model.UserName</h1>
    </div>

    <div class="row g-4 mb-5 text-center">
        <div class="col-md-4 animate-terminal-fade" style="animation-delay: 50ms;">
            <a href="/Shipments/Active" class="text-decoration-none">
                <div class="p-4 border border-gold rounded h-100 btn-gold-hover position-relative" style="background: rgba(212, 175, 55, 0.05);">

                    @if (Model.ActiveShipmentsCount > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-gold text-black shadow-sm badge-pulse"
                              style="font-size: 0.8rem; padding: 0.5em 0.7em; z-index: 10; border: 2px solid #000;">
                            @Model.ActiveShipmentsCount
                        </span>
                    }

                    <i class="bi bi-box-seam fs-1 text-gold mb-3 d-block"></i>
                    <h5 class="text-white text-uppercase small fw-bold">Shipments</h5>
                </div>
            </a>
        </div>

        <div class="col-md-4 animate-terminal-fade" style="animation-delay: 100ms;">
            <a href="/Couriers/Request" class="text-decoration-none">
                <div class="p-4 border border-gold rounded h-100 btn-gold-hover" style="background: rgba(212, 175, 55, 0.05);">
                    <i class="bi bi-truck fs-1 text-gold mb-3 d-block"></i>
                    <h5 class="text-white text-uppercase small fw-bold">Courier Requests</h5>
                </div>
            </a>
        </div>

        <div class="col-md-4 animate-terminal-fade" style="animation-delay: 150ms;">
            <a href="/Shipments/CashOnDelivery" class="text-decoration-none">
                <div class="p-4 border border-gold rounded h-100 btn-gold-hover" style="background: rgba(212, 175, 55, 0.05);">
                    <i class="bi bi-currency-euro fs-1 text-gold mb-3 d-block"></i>
                    <h5 class="text-white text-uppercase small fw-bold">Cash On Delivery</h5>
                </div>
            </a>
        </div>
    </div>

    <div class="mb-5 animate-terminal-fade" style="animation-delay: 200ms;">
        <h5 class="text-gold text-uppercase small mb-4" style="letter-spacing: 2px;">Recent Action Log</h5>
        <div class="d-flex flex-nowrap overflow-auto pb-3 gap-3" style="scrollbar-width: thin; scrollbar-color: #D4AF37 #000;">
            @if (Model.RecentActions != null && Model.RecentActions.Any())
            {
                int delayCounter = 0;
                @foreach (var action in Model.RecentActions)
                {
                    <div class="card border-secondary flex-shrink-0 card-interactive animate-card-slide" style="width: 300px; background: #111; animation-delay: @(250 + (delayCounter * 40))ms;">
                        <div class="card-body">
                            <span class="badge border border-gold text-gold mb-2">@action.Status</span>
                            <h6 class="text-white mb-1">@action.Title</h6>
                            <p class="text-secondary small mb-3">@action.Type</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-gold fw-bold">@action.Amount</span>
                                <span class="text-muted small">@action.Date</span>
                            </div>
                        </div>
                    </div>
                    delayCounter++;
                }
            }
            else
            {
                <div class="text-secondary small py-4 ps-2">No recent terminal activity recorded.</div>
            }
        </div>
    </div>

    <div class="row g-4 animate-terminal-fade" style="animation-delay: 350ms;">
        <div class="col-md-6">
            <div class="p-4 border border-secondary rounded panel-glow-ambient" style="background: rgba(255,255,255,0.02);">
                <span class="text-secondary small text-uppercase">Total Logistics Expenditure</span>
                <h2 class="text-white mt-2 fw-bold">€@Model.TotalSpent.ToString("N2")</h2>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-4 border border-secondary rounded panel-glow-ambient" style="background: rgba(255,255,255,0.02);">
                <span class="text-secondary small text-uppercase">Total COD Earnings</span>
                <h2 class="text-gold mt-2 fw-bold">€@Model.TotalEarned.ToString("N2")</h2>
            </div>
        </div>
    </div>
</div>

<style>
    /* --- SYSTEM UI KEYFRAME ANIMATION ENGINE (Razor Safe) --- */
    .animate-terminal-fade {
        opacity: 0;
        transform: translateY(10px);
        animation: terminalSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .animate-card-slide {
        opacity: 0;
        transform: translateX(15px);
        animation: terminalSlideLeft 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .badge-pulse {
        animation: criticalGlow 2s infinite ease-in-out;
    }

    /* DOUBLE @@ ESCAPED KEYFRAMES TO ELIMINATE IDE ERROR UNDERLINES */
    @@keyframes terminalSlideUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes terminalSlideLeft {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes criticalGlow {
        0%, 100% {
            box-shadow: 0 0 4px rgba(212, 175, 55, 0.4);
        }

        50% {
            box-shadow: 0 0 14px rgba(212, 175, 55, 0.8);
        }
    }
    /* -------------------------------------------------------- */

    .bg-gold {
        background-color: #D4AF37 !important;
    }

    .text-gold {
        color: #D4AF37 !important;
    }

    .border-gold {
        border-color: #D4AF37 !important;
    }

    .btn-gold-hover {
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.25s ease, box-shadow 0.25s ease;
        cursor: pointer;
    }

        .btn-gold-hover:hover {
            background: rgba(212, 175, 55, 0.12) !important;
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.6), 0 0 10px rgba(212,175,55,0.1);
        }

    .card-interactive {
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

        .card-interactive:hover {
            transform: translateY(-2px);
            border-color: #D4AF37 !important;
        }

    .panel-glow-ambient {
        transition: box-shadow 0.3s ease;
    }

        .panel-glow-ambient:hover {
            box-shadow: inset 0 0 15px rgba(255,255,255,0.02), 0 4px 20px rgba(0,0,0,0.4);
        }

    ::-webkit-scrollbar {
        height: 4px;
    }

    ::-webkit-scrollbar-track {
        background: #000;
    }

    ::-webkit-scrollbar-thumb {
        background: #D4AF37;
    }
</style>