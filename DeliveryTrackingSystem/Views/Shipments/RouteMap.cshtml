@model DeliveryTrackingSystem.Models.Shipment
@{
    ViewData["Title"] = "Route Map";
}

<h2>Shipment Route Map</h2>

<p><strong>Tracking Code:</strong> @Model.TrackingCode</p>
<p><strong>Route:</strong> @Model.DeliveryRoute.StartLocation → @Model.DeliveryRoute.EndLocation</p>

<div id="map" style="height: 500px; width: 100%;"></div>

@section Scripts {
        <script src="https://maps.googleapis.com/maps/api/js?key=YOUR_GOOGLE_MAPS_API_KEY"></script>
        <script>
            function initMap() {
                var start = { lat: 42.6977, lng: 23.3219 }; // Example: Sofia
                var end = { lat: 42.1354, lng: 24.7453 };   // Example: Plovdiv

                var map = new google.maps.Map(document.getElementById('map'), {
                    center: start,
                    zoom: 7
                });

                var startMarker = new google.maps.Marker({ position: start, map: map, title: "Start" });
                var endMarker = new google.maps.Marker({ position: end, map: map, title: "End" });

                var routePath = new google.maps.Polyline({
                    path: [start, end],
                    geodesic: true,
                    strokeColor: '#FF0000',
                    strokeOpacity: 1.0,
                    strokeWeight: 2
                });

                routePath.setMap(map);
            }

            initMap();
        </script>
}
