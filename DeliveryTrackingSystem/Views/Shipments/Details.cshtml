@model Cargobell.Shared.ViewModels.ShipmentTrackingViewModel

<div class="container py-5 terminal-fade-in" style="max-width: 1200px;">
    <div class="card bg-soft-black border-gold shadow-lg overflow-hidden" style="background-color: #0a0a0a; border: 1px solid #D4AF37;">

        @* HEADER ELEMENT *@
        <div class="p-4 p-md-5 border-bottom border-gold bg-black">
            <div class="row align-items-center">
                <div class="col-md-7">
                    <h4 class="text-secondary small mb-1 uppercase-tracking" style="letter-spacing: 2px; color: #888;">ASSET MANIFEST</h4>
                    <h1 class="text-gold mb-0 tracking-tight fw-bold" style="color: #D4AF37;">ID: @Model.TrackingCode</h1>
                    <p class="text-white-50 mt-3 mb-0 small">
                        <i class="bi bi-geo-alt-fill text-gold me-2" style="color: #D4AF37;"></i> @Model.Route
                    </p>
                </div>
                <div class="col-md-5 text-md-end mt-4 mt-md-0">
                    <div class="d-inline-block text-center p-3 border border-gold rounded" style="border-color: #D4AF37 !important; background: rgba(212,175,55,0.02);">
                        <p class="text-secondary small uppercase-tracking mb-1" style="letter-spacing: 1px; color: #888;">Current Status</p>
                        <h4 class="text-gold mb-0 fw-bold" style="color: #D4AF37;">@Model.Status?.ToUpper()</h4>
                    </div>
                </div>
            </div>
        </div>

        @* BODY LAYOUT SPLIT *@
        <div class="card-body p-4 p-md-5">
            <div class="row g-5">

                @* LEFT COLUMN: TIMELINE ENTRY CHAIN *@
                <div class="col-lg-7">
                    <h5 class="text-white uppercase-tracking small mb-5" style="letter-spacing: 1.5px;">Transit Chain Events</h5>

                    <div class="position-relative">
                        <div class="position-absolute h-100 border-start border-secondary opacity-25" style="left: 0.75rem; top: 0; border-color: #444 !important;"></div>

                        @if (!Model.StatusHistory.Any())
                        {
                            <div class="text-muted small font-monospace py-3 ps-4">INITIALIZING LOGISTICS TIMELINE CONTEXT...</div>
                        }

                        @foreach (var history in Model.StatusHistory.OrderByDescending(h => h.Timestamp))
                        {
                            <div class="d-flex mb-5 position-relative">
                                <div class="bg-black border border-gold rounded-circle d-flex align-items-center justify-content-center shadow-gold"
                                     style="width: 1.5rem; height: 1.5rem; z-index: 2; border-color: #D4AF37 !important;">
                                    <div class="bg-gold rounded-circle" style="width: 0.5rem; height: 0.5rem; background-color: #D4AF37;"></div>
                                </div>
                                <div class="ms-4 w-100">
                                    <h6 class="text-gold mb-1 fw-bold d-inline-block" style="color: #D4AF37;">@history.Status?.Name</h6>

                                    @if (!string.IsNullOrEmpty(history.Note))
                                    {
                                        if (history.Note.Contains("ANOMALY"))
                                        {
                                            <div class="mt-1 mb-2 p-2 bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded d-block max-w-100">
                                                <span class="text-danger small font-monospace fw-bold">
                                                    <i class="bi bi-exclamation-octagon-fill me-1"></i>
                                                    @history.Note.Replace("ANOMALY: ", "").ToUpper()
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-muted small mb-1 font-monospace italic text-wrap">// @history.Note</p>
                                        }
                                    }

                                    <p class="text-secondary small mb-0 font-monospace" style="color: #666;">@history.Timestamp.ToString("MMMM dd, yyyy — HH:mm")</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* RIGHT COLUMN: LOGISTICS PROFILE METRICS DATA *@
                <div class="col-lg-5">
                    <h5 class="text-white uppercase-tracking small mb-5" style="letter-spacing: 1.5px;">Logistics Profile</h5>

                    <div class="p-4 rounded border border-secondary mb-4" style="background: #111; border-color: #222 !important;">

                        @* TIMESTAMPS *@
                        <div class="mb-3">
                            <span class="text-muted small d-block font-monospace uppercase-tracking">MANIFEST LOGGED</span>
                            <span class="text-white font-monospace">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
                        </div>

                        <div class="mb-3">
                            <span class="text-muted small d-block font-monospace uppercase-tracking">ESTIMATED ETA</span>
                            <span class="text-gold font-monospace fw-bold" style="color: #D4AF37;">
                                @(Model.EstimatedDelivery.HasValue? Model.EstimatedDelivery.Value.ToString("yyyy-MM-dd") : "CALCULATING ROUTE...")
                            </span>
                        </div>

                        @if (Model.DeliveredDate.HasValue)
                        {
                            <div class="mb-3">
                                <span class="text-success small d-block font-monospace uppercase-tracking fw-bold">COMPLETION TIMESTAMP</span>
                                <span class="text-success font-monospace fw-bold">@Model.DeliveredDate.Value.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                        }

                        <hr class="border-secondary opacity-25 my-3" style="border-color: #333 !important;">

                        @* FIXED SECTION: FINANCIAL VALUES BREAKDOWN IN EURO *@
                        <div class="mb-3">
                            <span class="text-muted small d-block font-monospace uppercase-tracking">SHIPPING COST</span>
                            <span class="text-white font-monospace fs-5 fw-bold">€@Model.ShippingCost.ToString("N2")</span>
                        </div>

                        @if (Model.IsCashOnDelivery)
                        {
                            <div class="p-3 mb-3 bg-success bg-opacity-10 border border-success border-opacity-25 rounded">
                                <span class="text-success small d-block font-monospace uppercase-tracking fw-bold mb-1">
                                    <i class="bi bi-currency-exchange me-1"></i> CASH ON DELIVERY (COD) DUE
                                </span>
                                <span class="text-success font-monospace fs-4 fw-bold">€@Model.CodAmount.ToString("N2")</span>
                                <small class="text-muted d-block mt-1 font-monospace" style="font-size: 0.7rem;">
                                    * Recipient must remit payment upon handoff.
                                </small>
                            </div>
                        }

                        <hr class="border-secondary opacity-25 my-3" style="border-color: #333 !important;">

                        @* CARGO PROFILE SECURITY TAGS *@
                        <div class="d-flex flex-wrap gap-2 mb-4">
                            @if (Model.IsFragile)
                            {
                                <div class="px-3 py-2 bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded d-flex align-items-center">
                                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
                                    <span class="text-danger small font-monospace fw-bold" style="font-size: 0.75rem;">FRAGILE HANDLING</span>
                                </div>
                            }
                            else
                            {
                                <div class="px-3 py-2 bg-opacity-10 border border-secondary rounded d-flex align-items-center" style="background: rgba(255,255,255,0.02);">
                                    <i class="bi bi-shield-check text-secondary me-2"></i>
                                    <span class="text-secondary small font-monospace" style="font-size: 0.75rem;">STANDARD HANDLING</span>
                                </div>
                            }
                        </div>

                        @* FREIGHT PROFILE NOTES *@
                        <div>
                            <span class="text-muted small d-block font-monospace uppercase-tracking mb-1">CARGO MANIFEST NOTES</span>
                            <div class="p-3 bg-black border border-secondary rounded" style="border-color: #222 !important;">
                                <p class="text-secondary small mb-0 font-monospace style-italic" style="font-size: 0.8rem; line-height: 1.4;">
                                    @(string.IsNullOrEmpty(Model.Notes) ? "NO SPECIALIZED HANDLING INSTRUCTIONS LOGGED BY ORIGINATOR." : Model.Notes.ToUpper())
                                </p>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

        @* FOOTER *@
        <div class="card-footer bg-black border-top border-secondary p-4 text-center" style="border-color: #222 !important;">
            <button onclick="window.print()" class="btn btn-sm btn-outline-secondary uppercase-tracking small" style="letter-spacing: 1px;">
                <i class="bi bi-printer me-2"></i> Export Manifest
            </button>
        </div>
    </div>
</div>