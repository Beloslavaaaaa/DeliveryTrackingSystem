@model DeliveryTrackingSystem.ViewModels.ShipmentTrackingViewModel

<div class="container py-5">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white p-4">
            <h2 class="mb-0">Shipment @Model.TrackingCode</h2>
            <p class="mb-0">Current Status: <strong>@Model.Status</strong></p>
        </div>
        <div class="card-body p-4">
            <h5>Route: <span class="text-muted">@Model.Route</span></h5>
            <hr />

            <h4 class="mt-4 mb-3">Shipment Timeline</h4>
            <div class="list-group">
                @foreach (var history in Model.StatusHistory)
                {
                        <div class="list-group-item list-group-item-action border-start border-4 border-primary mb-2">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1 text-primary">@history.Status.Name</h6>
                                <small class="text-muted">@history.Timestamp.ToString("f")</small>
                            </div>
                            <p class="mb-1 small">Updated by system.</p>
                        </div>
                }
            </div>
        </div>
        <div class="card-footer bg-light p-3 text-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to Search</a>
        </div>
    </div>
</div>