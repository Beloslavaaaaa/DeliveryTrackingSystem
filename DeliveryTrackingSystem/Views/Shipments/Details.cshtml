@model DeliveryTrackingSystem.ViewModels.ShipmentTrackingViewModel
@{
    ViewData["Title"] = "Shipment Details";
}

<h2>Shipment Details</h2>

<div>
    <p><strong>Tracking Code:</strong> @Model.Shipment.TrackingCode</p>
    <p><strong>Status:</strong> @Model.Shipment.Status.Name</p>
    <p><strong>Estimated Delivery:</strong> @(Model.Shipment.EstimatedDelivery?.ToString("g") ?? "N/A")</p>
    <p><strong>Route:</strong> @Model.Shipment.DeliveryRoute.StartLocation → @Model.Shipment.DeliveryRoute.EndLocation</p>
</div>

<h3>Status History</h3>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Time</th>
            <th>Status</th>
            <th>Location</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var history in Model.Shipment.StatusHistory.OrderByDescending(sh => sh.Timestamp))
        {
                <tr>
                    <td>@history.Timestamp.ToString("g")</td>
                    <td>@history.Status.Name</td>
                    <td>@history.Location</td>
                </tr>
        }
    </tbody>
</table>
