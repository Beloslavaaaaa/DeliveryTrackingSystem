@model DeliveryTrackingSystem.ViewModels.ShipmentTrackingViewModel
@{
    ViewData["Title"] = "Shipment Details";
}

<h2>Shipment Details</h2>

<p><strong>Tracking Code:</strong> @Model.TrackingCode</p>
<p><strong>Status:</strong> @Model.Status</p>
<p><strong>Route:</strong> @Model.Route</p>

<h3>Status History</h3>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Time</th>
            <th>Status</th>
            <th>Location</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var history in Model.StatusHistory)
        {
                <tr>
                    <td>@history.Timestamp.ToString("g")</td>
                    <td>@history.Status.Name</td>
                    <td>@history.Location</td>
                </tr>
        }
    </tbody>
</table>
