@model IEnumerable<DeliveryTrackingSystem.Models.Shipment>
@{
    ViewData["Title"] = "Global Manifest History";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-end mb-5">
        <div>
            <h4 class="text-secondary small mb-1" style="letter-spacing: 3px;">LOGISTICS</h4>
            <h1 class="text-gold display-6 fw-bold">MY MANIFESTS</h1>
        </div>
        <a href="/Couriers/Request?tab=create" class="btn btn-outline-gold px-4 py-2 small fw-bold">BOOK NEW SHIPMENT</a>
    </div>

    <div class="table-responsive border border-secondary rounded shadow-lg" style="background: rgba(255,255,255,0.02); backdrop-filter: blur(10px);">
        <table class="table table-dark table-hover mb-0 align-middle">
            <thead class="text-gold small uppercase" style="background: rgba(212, 175, 55, 0.05);">
                <tr>
                    <th class="ps-4 py-3 border-0">Tracking Code</th>
                    <th class="py-3 border-0">Route</th>
                    <th class="py-3 border-0">Distance / ETA</th>
                    <th class="py-3 border-0">Status</th>
                    <th class="py-3 border-0">Created</th>
                    <th class="pe-4 py-3 border-0 text-end">Action</th>
                </tr>
            </thead>
            <tbody class="text-white border-0">
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                                <tr>
                                    <td class="ps-4 py-4 fw-bold">#@item.TrackingCode</td>
                                    <td class="py-4">
                                        <div class="small">@item.DeliveryRoute?.StartLocation</div>
                                        <div class="text-secondary small">→ @item.DeliveryRoute?.EndLocation</div>
                                    </td>
                                    <td class="py-4">
                                        <div class="small">@item.DeliveryRoute?.DistanceKm km</div>
                                        <div class="text-gold small fw-bold">@item.DeliveryRoute?.EstimatedTimeHours hrs</div>
                                    </td>
                                    <td class="py-4">
                                        <span class="badge border @(item.Status?.Name == "Delivered" ? "border-success text-success" : "border-gold text-gold") px-3 py-2">
                                    @item.Status?.Name.ToUpper()
                                        </span>
                                    </td>
                                    <td class="py-4 text-secondary small">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="pe-4 py-4 text-end">
                                        <a href="/Shipments/Details?trackingCode=@item.TrackingCode" class="btn btn-sm btn-gold px-3">View Details</a>
                                    </td>
                                </tr>
                    }
                }
                else
                {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-secondary small">No manifest records found in your archive.</td>
                        </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background: rgba(212, 175, 55, 0.03) !important;
        transition: 0.3s;
    }
    .btn-outline-gold {
        border-color: #D4AF37;
        color: #D4AF37;
    }
    .btn-outline-gold:hover {
        background: #D4AF37;
        color: #000;
    }
</style>