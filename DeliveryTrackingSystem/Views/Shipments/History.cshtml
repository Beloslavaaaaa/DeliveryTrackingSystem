@model IEnumerable<Cargobell.Shared.Models.Shipment>
@{
    ViewData["Title"] = "Global Manifest History";
}

<div class="container py-5 terminal-fade-in">
    <div class="d-flex justify-content-between align-items-end mb-5 border-start border-gold ps-4">
        <div>
            <h4 class="text-secondary small mb-1 uppercase-tracking">Logistics Archive</h4>
            <h1 class="text-gold display-6 fw-bold tracking-tight">MY MANIFESTS</h1>
        </div>
        <a href="/Couriers/Request?tab=create" class="btn btn-gold px-4 py-2 small fw-bold uppercase-tracking shadow-gold">Book Shipment</a>
    </div>

    <div class="table-responsive terminal-card">
        <table class="table table-dark table-hover mb-0 align-middle">
            <thead class="bg-soft-black">
                <tr class="text-gold uppercase-tracking small">
                    <th class="ps-4 py-3 border-0">Tracking ID</th>
                    <th class="py-3 border-0">Route Sector</th>
                    <th class="py-3 border-0">ETA / Distance</th>
                    <th class="py-3 border-0">Status</th>
                    <th class="py-3 border-0">Created</th>
                    <th class="pe-4 py-3 border-0 text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any()) {
                    @foreach (var item in Model) {
                        <tr>
                            <td class="ps-4 py-4 fw-bold font-monospace">#@item.TrackingCode</td>
                            <td class="py-4">
                                <div class="text-white small">@item.DeliveryRoute?.StartLocation</div>
                                <div class="text-secondary" style="font-size: 0.7rem;">→ @item.DeliveryRoute?.EndLocation</div>
                            </td>
                            <td class="py-4">
                                <div class="text-gold small fw-bold">@item.DeliveryRoute?.EstimatedTimeHours hrs</div>
                                <div class="text-secondary small">@item.DeliveryRoute?.DistanceKm km</div>
                            </td>
                            <td class="py-4">
                                <span class="badge border @(item.Status?.Name == "Delivered" ? "border-success text-success" : "border-gold text-gold") px-3 py-2 uppercase-tracking" style="font-size: 0.6rem;">
                                    @item.Status?.Name
                                </span>
                            </td>
                            <td class="py-4 text-secondary small">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="pe-4 py-4 text-end">
                                <a href="/Shipments/Details?trackingCode=@item.TrackingCode" class="btn btn-sm btn-outline-gold px-3">View</a>
                            </td>
                        </tr>
                    }
                } else {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-secondary uppercase-tracking small">No manifest records found in archive.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>