@{
    ViewData["Title"] = "Cargobell | Your Cargo on the Bell";
}

<style>
    /* Full-screen background with the truck image */
    .hero-wrap {
        background: linear-gradient(rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0.75)), url('/images/cargo-bell-bg.jpg'); /* Make sure your image name matches exactly */
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        width: 100%;
        margin-top: -56px; /* Offsets navbar height if it's fixed */
        display: flex;
        align-items: center;
    }

    /* --- SYSTEM UI KEYFRAME ANIMATION ENGINE (Razor Safe) --- */
    .animate-terminal-fade {
        opacity: 0;
        transform: translateY(15px);
        animation: terminalSlideUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .animate-glow-pulse {
        animation: criticalGlow 2.5s infinite ease-in-out;
    }

    /* DOUBLE @@ ESCAPED KEYFRAMES TO ELIMINATE IDE ERROR UNDERLINES */
    @@keyframes terminalSlideUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes criticalGlow {
        0%, 100% {
            box-shadow: 0 4px 20px rgba(0,0,0,0.4), 0 0 4px rgba(212, 175, 55, 0.15);
            border-color: #D4AF37 !important;
        }

        50% {
            box-shadow: 0 4px 25px rgba(0,0,0,0.5), 0 0 15px rgba(212, 175, 55, 0.45);
            border-color: #f1c40f !important;
        }
    }
    /* -------------------------------------------------------- */

    /* Gold Theme Colors */
    .text-gold {
        color: #D4AF37 !important;
    }

    .btn-gold {
        background-color: #D4AF37;
        color: #000;
        font-weight: bold;
        transition: all 0.3s ease;
    }

        .btn-gold:hover {
            background-color: #f1c40f;
            transform: translateY(-2px);
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.4);
        }

    .btn-outline-gold {
        border: 1px solid #D4AF37;
        color: #D4AF37;
        transition: all 0.25s ease;
    }

        .btn-outline-gold:hover {
            background-color: #D4AF37;
            color: #000;
            transform: translateY(-2px);
            box-shadow: 0 0 10px rgba(212, 175, 55, 0.2);
        }

    .border-gold {
        border-color: #D4AF37 !important;
    }

    /* Subtle hover interactive logic for exterior content blocks */
    .card-interactive-node {
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
    }

        .card-interactive-node:hover {
            transform: translateY(-4px);
            border-color: #D4AF37 !important;
            box-shadow: 0 8px 24px rgba(0,0,0,0.5);
        }

    .tracking-input-field:focus {
        box-shadow: none !important;
        outline: none !important;
    }

    /* Uniform height rule applied to every single card */
    .uniform-card-height {
        min-height: 170px;
    }
</style>

<div class="hero-wrap">
    <div class="container py-5">
        <div class="text-center mb-5 animate-terminal-fade">
            <h1 class="display-1 fw-bold text-gold mb-0" style="letter-spacing: 2px;">CARGOBELL</h1>
            <p class="text-gold opacity-75 mt-0" style="letter-spacing: 8px; font-size: 0.9rem;">YOUR CARGO ON THE BELL</p>

            <div class="row justify-content-center mt-4">
                <div class="col-md-6">
                    <p class="fw-light text-white-50" style="line-height: 2;">
                        The gold standard in global logistics. Enter your manifest tracking ID below to monitor your assets in real-time.
                    </p>
                </div>
            </div>
        </div>

        <div class="row justify-content-center mb-5 animate-terminal-fade" style="animation-delay: 100ms;">
            <div class="col-md-8">
                <div class="card p-2 shadow-lg" style="background: rgba(0,0,0,0.4); backdrop-filter: blur(15px); border: 1px solid #D4AF37;">
                    <form asp-controller="Shipments" asp-action="Details" method="get">
                        <div class="input-group">
                            <input type="text" name="trackingCode"
                                   class="form-control form-control-lg bg-transparent text-white border-0 py-4 ps-4 tracking-input-field"
                                   placeholder="TRACKING CODE"
                                   style="letter-spacing: 4px;" required />
                            <button type="submit" class="btn btn-gold px-5">TRACK</button>
                        </div>
                    </form>
                </div>
                @if (TempData["Error"] != null)
                {
                    <p class="text-center text-danger mt-3 small fw-bold">@TempData["Error"]</p>
                }
            </div>
        </div>

        <div class="row g-4 mt-5 justify-content-center text-center">

            <div class="col-lg-4 col-md-6 animate-terminal-fade" style="animation-delay: 200ms;">
                <div class="p-4 border border-secondary rounded card-interactive-node d-flex flex-column justify-content-center uniform-card-height" style="background: rgba(0,0,0,0.6);">
                    <h5 class="text-gold text-uppercase small mb-2" style="letter-spacing: 3px;">Contact Us</h5>
                    <p class="small text-secondary fw-light mb-3">Reach out to our global concierge for direct support chains.</p>
                    <div>
                        <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-gold px-5 py-2">Open Inquiry</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 d-flex flex-column gap-4 animate-terminal-fade" style="animation-delay: 250ms;">
                <div class="p-4 border border-gold rounded shadow-lg card-interactive-node animate-glow-pulse d-flex flex-column justify-content-center uniform-card-height" style="background: rgba(212, 175, 55, 0.15); backdrop-filter: blur(5px);">
                    <h5 class="text-gold text-uppercase small mb-2" style="letter-spacing: 3px;">Pricing</h5>
                    <p class="small text-white fw-light mb-3">Calculate secure shipping rates for transit parameters.</p>
                    <div>
                        <a asp-controller="Home" asp-action="Pricing" class="btn btn-gold px-5 py-2">View Rates</a>
                    </div>
                </div>

                <div class="p-4 border border-secondary rounded card-interactive-node d-flex flex-column justify-content-center uniform-card-height" style="background: rgba(0,0,0,0.6);">
                    <h5 class="text-gold text-uppercase small mb-2" style="letter-spacing: 3px;">About Us</h5>
                    <p class="small text-secondary fw-light mb-3">Learn about our secure operational manifesto and global grid.</p>
                    <div>
                        <a asp-controller="Home" asp-action="About" class="btn btn-outline-gold px-5 py-2">Our Manifesto</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 animate-terminal-fade" style="animation-delay: 300ms;">
                <div class="p-4 border border-secondary rounded card-interactive-node d-flex flex-column justify-content-center uniform-card-height" style="background: rgba(0,0,0,0.6);">
                    <h5 class="text-gold text-uppercase small mb-2" style="letter-spacing: 3px;">Privacy Policy</h5>
                    <p class="small text-secondary fw-light mb-3">Learn about our extreme data protection algorithms.</p>
                    <div>
                        <a asp-controller="Home" asp-action="Privacy" class="btn btn-outline-gold px-5 py-2">Read Policy</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>