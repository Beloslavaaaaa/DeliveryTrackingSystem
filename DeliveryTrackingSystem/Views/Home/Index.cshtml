@{
    ViewData["Title"] = "Cargobell | Elite Logistics";
}

<div class="container py-5 mt-lg-5">
    <div class="text-center mb-5">
        <h1 class="display-1 fw-bold text-gold mb-0">CARGOBELL</h1>
        <p class="text-gold opacity-75 mt-0" style="letter-spacing: 8px; font-size: 0.9rem;">YOUR CARGO ON THE BELL</p>

        <div class="row justify-content-center mt-4">
            <div class="col-md-6">
                <p class="fw-light text-secondary" style="line-height: 2;">
                    The pinnacle of global logistics. Secure, swift, and strictly confidential. 
                    Monitor your assets with absolute precision.
                </p>
            </div>
        </div>
    </div>

    <div class="row justify-content-center mb-5">
        <div class="col-md-8">
            <div class="card p-2 shadow-lg" style="background: rgba(255,255,255,0.02); backdrop-filter: blur(10px);">
                <form asp-controller="Shipments" asp-action="Details" method="get">
                    <div class="input-group">
                        <input type="text" name="trackingCode" 
                               class="form-control form-control-lg bg-transparent text-white border-0 py-4 ps-4" 
                               placeholder="MANIFEST TRACKING ID" 
                               style="letter-spacing: 4px; font-family: 'Cinzel', serif;" required />
                        <button type="submit" class="btn btn-gold px-5">
                            FIND
                        </button>
                    </div>
                </form>
            </div>
            @if (TempData["Error"] != null)
            {
                    <p class="text-center text-danger mt-3 small fw-bold">@TempData["Error"]</p>
            }
        </div>
    </div>

    <div class="row g-5 mt-5 text-center">
        <div class="col-md-4">
            <div class="p-4">
                <h5 class="text-gold text-uppercase small mb-3" style="letter-spacing: 3px;">Concierge</h5>
                <p class="small text-secondary fw-light mb-4">Dedicated 24-hour asset management.</p>
                <a asp-action="Contact" class="btn btn-outline-gold btn-sm px-4">Inquire</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4">
                <h5 class="text-gold text-uppercase small mb-3" style="letter-spacing: 3px;">Transparency</h5>
                <p class="small text-secondary fw-light mb-4">Our commitment to data sovereignty.</p>
                <a asp-action="Privacy" class="btn btn-outline-gold btn-sm px-4">Protocols</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4">
                <h5 class="text-gold text-uppercase small mb-3" style="letter-spacing: 3px;">Valuation</h5>
                <p class="small text-secondary fw-light mb-4">Custom rates for high-value transit.</p>
                <a asp-action="Pricing" class="btn btn-outline-gold btn-sm px-4">Schedule</a>
            </div>
        </div>
    </div>
</div>