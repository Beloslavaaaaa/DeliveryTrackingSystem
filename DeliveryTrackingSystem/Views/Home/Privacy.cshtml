@{
    ViewData["Title"] = "Security & Privacy Manifesto | Cargobell";
}

<div class="container py-5 mt-lg-5">
    <div class="text-center mb-5">
        <h1 class="display-4 text-gold mb-2">PRIVACY PROTOCOL</h1>
        <p class="text-gold opacity-50" style="letter-spacing: 5px;">DATA ENCRYPTION & ASSET PROTECTION</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card p-5 border-secondary shadow-lg" style="background: rgba(255,255,255,0.02); backdrop-filter: blur(10px);">

                <h3 class="h5 text-white mb-4 text-uppercase fw-bold" style="letter-spacing: 2px;">Core Directives</h3>

                <ul class="list-unstyled">
                    <li class="mb-4 d-flex align-items-start">
                        <i class="bi bi-arrow-right-short text-gold fs-3 me-3"></i>
                        <div>
                            <span class="text-white fw-bold d-block text-uppercase small">Identity Sovereignty</span>
                            <p class="text-secondary small mb-0">Your personal data is encrypted at the point of entry. Cargobell never trades or sells client identities to third-party brokers.</p>
                        </div>
                    </li>

                    <li class="mb-4 d-flex align-items-start">
                        <i class="bi bi-arrow-right-short text-gold fs-3 me-3"></i>
                        <div>
                            <span class="text-white fw-bold d-block text-uppercase small">Manifest Confidentiality</span>
                            <p class="text-secondary small mb-0">Detailed shipment contents are visible only to the authorized account holder and essential transit customs officials.</p>
                        </div>
                    </li>

                    <li class="mb-4 d-flex align-items-start">
                        <i class="bi bi-arrow-right-short text-gold fs-3 me-3"></i>
                        <div>
                            <span class="text-white fw-bold d-block text-uppercase small">Geospatial Discretion</span>
                            <p class="text-secondary small mb-0">Tracking data is archived for 30 days post-delivery and then purged from our active servers to ensure route anonymity.</p>
                        </div>
                    </li>

                    <li class="mb-4 d-flex align-items-start">
                        <i class="bi bi-arrow-right-short text-gold fs-3 me-3"></i>
                        <div>
                            <span class="text-white fw-bold d-block text-uppercase small">Financial Fortification</span>
                            <p class="text-secondary small mb-0">Payment processing is handled via secure, PCI-compliant vaults. Cargobell does not store full credit card credentials on local databases.</p>
                        </div>
                    </li>

                    <li class="mb-4 d-flex align-items-start">
                        <i class="bi bi-arrow-right-short text-gold fs-3 me-3"></i>
                        <div>
                            <span class="text-white fw-bold d-block text-uppercase small">The Right to Erasure</span>
                            <p class="text-secondary small mb-0">Upon request, we will initiate a "Total Purge" protocol, removing all non-regulatory history associated with your profile.</p>
                        </div>
                    </li>
                </ul>

                <hr class="border-secondary opacity-25 my-5">

                <div class="text-center">
                    <p class="small text-secondary italic mb-4">By utilizing the Cargobell network, you consent to these elite security standards.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-gold px-5 py-2">Return to Command</a>
                </div>

            </div>
        </div>
    </div>
</div>