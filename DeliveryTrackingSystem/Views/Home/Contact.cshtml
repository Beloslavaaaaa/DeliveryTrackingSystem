@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Contact Concierge | Cargobell";
}

<div class="container py-5 mt-lg-5">
    <div class="text-center mb-5">
        <h1 class="display-4 text-gold mb-2">GLOBAL CONCIERGE</h1>
        <p class="text-gold opacity-50" style="letter-spacing: 5px;">STRATEGIC HEADQUARTERS</p>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card p-4 border-secondary h-100" style="background: rgba(255,255,255,0.02);">
                <h3 class="h5 text-white mb-4 text-uppercase fw-bold">Send an Inquiry</h3>
                <form>
                    <div class="mb-3">
                        <input type="text" class="form-control bg-transparent text-white border-secondary py-3" placeholder="YOUR NAME">
                    </div>
                    <div class="mb-3">
                        <input type="email" class="form-control bg-transparent text-white border-secondary py-3" placeholder="EMAIL ADDRESS">
                    </div>
                    <div class="mb-3">
                        <textarea class="form-control bg-transparent text-white border-secondary py-3" rows="4" placeholder="MESSAGE"></textarea>
                    </div>
                    <button type="submit" class="btn btn-gold w-100 py-3">Dispatch Message</button>
                </form>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card p-1 border-gold h-100" style="background: #000; min-height: 450px;">
                <div id="map" style="height: 100%; width: 100%; min-height: 450px; filter: grayscale(1) invert(0.9) sepia(1) hue-rotate(0deg) saturate(0.5);"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
                <script src="https://maps.googleapis.com/maps/api/js?key=@Configuration["GoogleMaps:ApiKey"]&callback=initMap" async defer></script>

        <script>
            function initMap() {
                const bulgariaHQ = { lat: 42.6977, lng: 23.3219 };

                const map = new google.maps.Map(document.getElementById("map"), {
                    zoom: 5,
                    center: bulgariaHQ,
                    styles: [
                        { "stylers": [{ "visibility": "simplified" }] },
                        { "stylers": [{ "color": "#131314" }] },
                        { "featureType": "water", "stylers": [{ "color": "#000000" }] },
                        { "featureType": "gold", "elements": "geometry", "stylers": [{ "color": "#D4AF37" }] }
                    ],
                    disableDefaultUI: true 
                });

                const marker = new google.maps.Marker({
                    position: bulgariaHQ,
                    map: map,
                    title: "Cargobell Bulgaria HQ",
                    icon: {
                        path: google.maps.SymbolPath.CIRCLE,
                        scale: 10,
                        fillColor: "#D4AF37",
                        fillOpacity: 1,
                        strokeWeight: 2,
                        strokeColor: "#FFFFFF"
                    }
                });

                const infoWindow = new google.maps.InfoWindow({
                    content: '<div style="color:#000; padding:10px;"><strong>CARGOBELL HQ</strong><br>Sofia, Bulgaria</div>'
                });

                marker.addListener("click", () => {
                    infoWindow.open(map, marker);
                });
            }
        </script>
}