@{
    ViewData["Title"] = "Contact Us | Cargobell";
}

<div class="container py-5 mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4 text-gold mb-2">CONTACT US</h1>
        <p class="text-gold opacity-50" style="letter-spacing: 5px;">DIRECT CONCIERGE LINE</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="row g-5">
                <div class="col-md-4">
                    <div class="mb-5">
                        <h6 class="text-gold text-uppercase mb-3" style="letter-spacing: 2px;">Headquarters</h6>
                        <p class="text-secondary small">Wall St. 100, Financial District<br />New York, NY 10005</p>
                    </div>
                    <div class="mb-5">
                        <h6 class="text-gold text-uppercase mb-3" style="letter-spacing: 2px;">Support</h6>
                        <p class="text-secondary small">concierge@cargobell.com<br />+1 (800) CARGO-BELL</p>
                    </div>
                </div>
                <div class="col-md-8">
                    <form class="card p-4 border-0 shadow-lg" style="background: #111;">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="small text-gold text-uppercase mb-2">Your Name</label>
                                <input type="text" class="form-control bg-dark border-secondary text-white py-3" required />
                            </div>
                            <div class="col-md-6">
                                <label class="small text-gold text-uppercase mb-2">Email</label>
                                <input type="email" class="form-control bg-dark border-secondary text-white py-3" required />
                            </div>
                            <div class="col-12 mt-4">
                                <label class="small text-gold text-uppercase mb-2">Message</label>
                                <textarea class="form-control bg-dark border-secondary text-white py-3" rows="5" required></textarea>
                            </div>
                            <div class="col-12 mt-4 text-end">
                                <button type="submit" class="btn btn-gold px-5 py-3">SEND INQUIRY</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>