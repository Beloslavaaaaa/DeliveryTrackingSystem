@model IEnumerable<DeliveryTrackingSystem.Models.CourierRequest>
@{
    ViewData["Title"] = "Courier Services";
    string activeTab = ViewBag.ActiveTab ?? "active";
    var activeRequests = Model?.Where(r => !r.IsCompleted).ToList() ?? new List<DeliveryTrackingSystem.Models.CourierRequest>();
    var finishedRequests = Model?.Where(r => r.IsCompleted).ToList() ?? new List<DeliveryTrackingSystem.Models.CourierRequest>();
}

<div class="container py-5">
    <div class="mb-5">
        <h4 class="text-secondary small mb-1" style="letter-spacing: 3px;">SERVICE TERMINAL</h4>
        <h1 class="text-gold display-6 fw-bold">COURIER DISPATCH</h1>
    </div>

    <div class="d-flex border-bottom border-secondary mb-4">
        <a href="?tab=active" class="py-2 px-4 text-decoration-none small fw-bold @(activeTab == "active" ? "text-gold border-bottom border-gold" : "text-secondary")">
            ACTIVE (@activeRequests.Count)
        </a>
        <a href="?tab=finished" class="py-2 px-4 text-decoration-none small fw-bold @(activeTab == "finished" ? "text-gold border-bottom border-gold" : "text-secondary")">
            FINISHED (@finishedRequests.Count)
        </a>
        <a href="?tab=create" class="ms-auto btn btn-gold btn-sm px-4 fw-bold">
            + NEW REQUEST
        </a>
    </div>

    <div class="mt-4">
        @if (activeTab == "active")
        {
                <div class="row g-4">
                @if (activeRequests.Any())
                {
                    @foreach (var req in activeRequests)
                    {
                                    <div class="col-md-6">
                                        <div class="card bg-dark border-secondary p-3 h-100 shadow">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <span class="badge border border-gold text-gold mb-2" style="font-size: 0.6rem;">@req.Status.ToUpper()</span>
                                                    <h6 class="text-white fw-bold">@req.PackageDescription</h6>
                                                    <p class="text-secondary small mb-0">@req.PickupAddress</p>
                                                </div>
                                                <div class="text-end text-gold small fw-bold">
                                        @req.PreferredPickupTime.ToString("HH:mm")<br />
                                                    <span class="text-secondary">@req.PreferredPickupTime.ToString("MMM dd")</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                    }
                }
                else
                {
                            <div class="col-12 text-center py-5 border border-secondary border-dashed rounded" style="border-style: dashed !important;">
                                <p class="text-secondary mb-0 small uppercase">No active dispatch requests found.</p>
                            </div>
                }
                </div>
        }
        else if (activeTab == "finished")
        {
            @if (finishedRequests.Any())
            {
                        <div class="table-responsive border border-secondary rounded">
                            <table class="table table-dark mb-0 small">
                                <thead>
                                    <tr class="text-gold">
                                        <th class="ps-4 py-3">COMPLETED DATE</th>
                                        <th>DESCRIPTION</th>
                                        <th>ADDRESS</th>
                                        <th class="pe-4 text-end">STATUS</th>
                                    </tr>
                                </thead>
                                <tbody>
                            @foreach (var req in finishedRequests)
                            {
                                            <tr>
                                                <td class="ps-4">@req.CreatedAt.ToString("yyyy-MM-dd")</td>
                                                <td>@req.PackageDescription</td>
                                                <td>@req.PickupAddress</td>
                                                <td class="pe-4 text-end text-success small">ARCHIVED</td>
                                            </tr>
                            }
                                </tbody>
                            </table>
                        </div>
            }
            else
            {
                        <div class="text-center py-5 border border-secondary border-dashed rounded" style="border-style: dashed !important;">
                            <p class="text-secondary mb-0 small uppercase">Archive is empty.</p>
                        </div>
            }
        }
        else if (activeTab == "create")
        {
                <div class="row justify-content-center">
                    <div class="col-md-7">
                        <div class="card bg-dark border-gold p-4">
                            <form asp-action="Create" method="post">
                                <div class="mb-3">
                                    <label class="text-gold small fw-bold mb-2">DESCRIPTION</label>
                                    <input name="PackageDescription" class="form-control bg-transparent text-white border-secondary" required />
                                </div>
                                <div class="mb-3">
                                    <label class="text-gold small fw-bold mb-2">PICKUP LOCATION</label>
                                    <input name="PickupAddress" class="form-control bg-transparent text-white border-secondary" required />
                                </div>
                                <div class="mb-4">
                                    <label class="text-gold small fw-bold mb-2">PICKUP TIME</label>
                                    <input name="PreferredPickupTime" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" class="form-control bg-transparent text-white border-secondary" required />
                                </div>
                                <button type="submit" class="btn btn-gold w-100 py-3 fw-bold">SEND REQUEST</button>
                            </form>
                        </div>
                    </div>
                </div>
        }
    </div>
</div>

<style>
    .border-gold { border: 1px solid #D4AF37; }
    .text-gold { color: #D4AF37 !important; }
    .btn-gold { background: linear-gradient(45deg, #BF953F, #FCF6BA, #B38728); color: black; border: none; }
</style>