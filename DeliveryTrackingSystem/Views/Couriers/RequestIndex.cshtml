@model IEnumerable<Cargobell.Shared.Models.CourierRequest>
@using Microsoft.AspNetCore.Identity
@inject UserManager<Cargobell.Shared.Models.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Courier Services | Cargobell";
    string activeTab = ViewBag.ActiveTab ?? "active";
    var currentUser = await UserManager.GetUserAsync(User);
    
    // Safety check for null model
    var requests = Model ?? new List<Cargobell.Shared.Models.CourierRequest>();
    var activeRequests = requests.Where(r => !r.IsCompleted).ToList();
    var finishedRequests = requests.Where(r => r.IsCompleted).ToList();
}

<div class="container py-5">
    <div class="mb-5 text-center">
        <h4 class="text-secondary small mb-1" style="letter-spacing: 3px;">SERVICE TERMINAL</h4>
        <h1 class="text-gold display-6 fw-bold">COURIER DISPATCH</h1>
    </div>

    <div class="d-flex border-bottom border-secondary mb-5 justify-content-center">
        <a href="?tab=active" class="py-2 px-4 text-decoration-none small fw-bold @(activeTab == "active" ? "text-gold border-bottom border-gold" : "text-secondary")">ACTIVE (@activeRequests.Count)</a>
        <a href="?tab=finished" class="py-2 px-4 text-decoration-none small fw-bold @(activeTab == "finished" ? "text-gold border-bottom border-gold" : "text-secondary")">HISTORY (@finishedRequests.Count)</a>
        <a href="?tab=create" class="py-2 px-4 text-decoration-none small fw-bold @(activeTab == "create" ? "text-gold border-bottom border-gold" : "text-secondary")">+ NEW REQUEST</a>
    </div>

    @if (activeTab == "active" || activeTab == "finished")
    {
        var displayList = activeTab == "active" ? activeRequests : finishedRequests;
        <div class="row g-4">
            @if (!displayList.Any())
            {
                <div class="col-12 text-center py-5">
                    <p class="text-secondary">No requests found in this category.</p>
                </div>
            }
            @foreach (var req in displayList)
            {
                <div class="col-md-6">
                    <div class="card bg-soft-black border-secondary p-4 h-100 position-relative overflow-hidden shadow">
                        <div class="gold-accent-bar"></div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="badge border border-gold text-gold">@req.Status?.ToUpper()</span>
                            <span class="text-gold fw-bold">€@req.EstimatedPrice.ToString("F2")</span>
                        </div>
                        <h5 class="text-white fw-bold">@req.PackageDescription</h5>
                        <p class="small text-secondary mb-1 uppercase">Pickup: <span class="text-white">@req.PickupAddress</span></p>
                        <p class="small text-secondary mb-3 uppercase">Dropoff: <span class="text-white">@req.DropoffAddress</span></p>
                        
                        @if (req.Status == "Pending")
                        {
                            <form asp-action="Cancel" asp-route-id="@req.CourierRequestId" method="post">
                                <button type="submit" class="btn btn-outline-danger btn-sm px-4">CANCEL</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (activeTab == "create")
    {
        <div class="row justify-content-center">
            <div class="col-md-9">
                <div class="d-flex justify-content-between mb-5 position-relative px-5">
                    <div class="progress-line"></div>
                    <div class="step-circle active" data-step="1">1<span>Sender</span></div>
                    <div class="step-circle" data-step="2">2<span>Address</span></div>
                    <div class="step-circle" data-step="3">3<span>Shipment</span></div>
                    <div class="step-circle" data-step="4">4<span>Timing</span></div>
                </div>

                <div class="card p-5 bg-soft-black border-gold-subtle shadow-lg">
                    <form asp-action="Create" method="post" id="dispatchForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="step-content" id="step-1">
                            <h5 class="text-gold mb-3 small fw-bold uppercase">Step 1: Dispatch Parties</h5>

                            @* SENDER BLOCK *@
                            <div class="mb-4">
                                <label class="smaller text-secondary d-block mb-2">Originator / Sender Context</label>
                                <div class="btn-group w-100 mb-3">
                                    <input type="radio" class="btn-check" name="IsCustomSender" id="myInfo" value="false" checked>
                                    <label class="btn btn-outline-gold py-2 small" for="myInfo">My Profile</label>
                                    <input type="radio" class="btn-check" name="IsCustomSender" id="otherInfo" value="true">
                                    <label class="btn btn-outline-gold py-2 small" for="otherInfo">Other Contact</label>
                                </div>
                                <div id="myInfoFields" class="p-3 border border-secondary rounded text-center small text-white-50 bg-black">
                                    <i class="bi bi-person-fill text-gold me-2"></i> @currentUser?.UserName | @currentUser?.PhoneNumber
                                </div>
                                <div id="otherInfoFields" style="display:none;">
                                    <input type="text" name="CustomSenderName" class="form-control bg-dark text-white border-secondary mb-2" placeholder="Sender Full Name">
                                    <input type="text" name="CustomSenderPhone" class="form-control bg-dark text-white border-secondary mb-0" placeholder="Sender Phone Number">
                                </div>
                            </div>

                            <hr class="border-secondary opacity-25 my-4">

                            @* NEW UPDATED RECEIVER BLOCK *@
                            <div class="mb-2">
                                <label class="smaller text-gold d-block mb-2">Destination Recipient</label>
                                <input type="text" name="ReceiverName" class="form-control bg-dark text-white border-secondary mb-2 py-2" placeholder="Recipient Full Name*" required>
                                <span class="text-danger smaller d-block mb-2" id="val-ReceiverName"></span>

                                <input type="text" name="ReceiverPhone" class="form-control bg-dark text-white border-secondary mb-0 py-2" placeholder="Recipient Phone Number*" required>
                                <span class="text-danger smaller d-block" id="val-ReceiverPhone"></span>
                            </div>
                        </div>

                        <div class="step-content d-none" id="step-2">
                            <h5 class="text-gold mb-4 small fw-bold uppercase">Step 2: Route</h5>
                            <input name="PickupAddress" class="form-control bg-dark text-white border-secondary mb-1 py-3" placeholder="Pickup Address*" required>
                            <span class="text-danger smaller mb-3 d-block" id="val-PickupAddress"></span>
                            
                            <input name="DropoffAddress" class="form-control bg-dark text-white border-secondary mb-1 py-3" placeholder="Dropoff Address*" required>
                            <span class="text-danger smaller d-block" id="val-DropoffAddress"></span>
                        </div>

                        <div class="step-content d-none" id="step-3">
                            <h5 class="text-gold mb-4 small fw-bold uppercase">Step 3: Shipment</h5>
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <select name="DestinationZone" id="calcDest" class="form-select bg-dark text-white border-secondary">
                                        <option value="1">Domestic</option>
                                        <option value="2.5">International (EU)</option>
                                        <option value="5.0">International (Global)</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <select name="PackageType" id="calcSize" class="form-select bg-dark text-white border-secondary">
                                        <option value="5">Document Envelope (€5)</option>
                                        <option value="15">Small Parcel (&lt; 2kg) (€15)</option>
                                        <option value="35">Standard Box (&lt; 10kg) (€35)</option>
                                        <option value="70">Heavy Freight (&lt; 30kg) (€70)</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-6">
                                    <div class="form-check"><input type="checkbox" name="IsFragile" value="true" class="form-check-input" id="fCheck"><label class="text-white small">Fragile (+€5)</label></div>
                                </div>
                                <div class="col-6">
                                    <div class="form-check"><input type="checkbox" name="IsCashOnDelivery" value="true" class="form-check-input" id="codCheck"><label class="text-white small">COD</label></div>
                                    <input type="number" step="0.01" name="CodAmount" id="codWrap" class="form-control bg-dark text-white border-gold mt-2" placeholder="€" style="display:none;">
                                </div>
                                <div id="codAmountWrapper" class="mb-4" style="display:none;">
                                <label class="smaller text-gold">COD AMOUNT TO COLLECT (€)</label>
                                <input type="number" step="0.01" name="CodAmount" class="form-control bg-dark text-white border-gold py-2" placeholder="0.00">
                            </div>
                            </div>
                            <input type="text" name="PackageDescription" class="form-control bg-dark text-white border-secondary mb-1" placeholder="Description*" required>
                            <span class="text-danger smaller d-block mb-3" id="val-PackageDescription"></span>
                            
                            <div class="text-center p-3 bg-black border border-secondary mt-3"><h2 id="calcTotal" class="text-gold mb-0">€5.00</h2></div>
                        </div>

                        <div class="step-content d-none" id="step-4">
                            <h5 class="text-gold mb-4 small fw-bold uppercase">Step 4: Timing</h5>
                            <input type="date" name="PreferredPickupTime" id="pickupDate" class="form-control bg-dark text-white border-secondary mb-4 py-3" required>
                            <div class="row">
                                <div class="col">
                                    <label class="smaller text-secondary">Start Time</label>
                                    <input type="time" name="TimeStart" class="form-control bg-dark text-white border-secondary" value="09:00">
                                </div>
                                <div class="col">
                                    <label class="smaller text-secondary">End Time</label>
                                    <input type="time" name="PreferredPickupTimeEnd" class="form-control bg-dark text-white border-secondary" value="17:00">
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-5">
                            <button type="button" class="btn btn-dark border-secondary flex-grow-1 py-3" id="prevBtn" style="display:none">BACK</button>
                            <button type="button" class="btn btn-gold flex-grow-1 py-3 fw-bold" id="nextBtn">CONTINUE</button>
                            <button type="submit" class="btn btn-gold flex-grow-1 py-3 fw-bold" id="submitBtnFinal" style="display:none">INITIALIZE REQUEST</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<style>
    :root { --gold: #D4AF37; --soft-black: #0b0b0b; }
    body { background-color: #050505; color: white; }
    .bg-soft-black { background-color: var(--soft-black) !important; }
    .text-gold { color: var(--gold) !important; }
    .btn-gold { background: var(--gold); color: black; border: none; }
    .btn-outline-gold { border-color: var(--gold); color: var(--gold); }
    .progress-line { position: absolute; top: 20px; left: 10%; right: 10%; height: 1px; background: #333; z-index: 0; }
    .step-circle { width: 40px; height: 40px; border-radius: 50%; background: #111; border: 1px solid #333; display: flex; align-items: center; justify-content: center; position: relative; z-index: 1; color: #555; }
    .step-circle.active { border-color: var(--gold); color: var(--gold); }
    .step-circle span { position: absolute; top: 45px; font-size: 0.6rem; text-transform: uppercase; white-space: nowrap; color: #555; }
    .gold-accent-bar { position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: var(--gold); }
    .smaller { font-size: 0.65rem; text-transform: uppercase; }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            let step = 1;
           function updateUI() {
                // Toggle Buttons
                $('#prevBtn').toggle(step > 1);
                if(step === 4) { $('#nextBtn').hide(); $('#submitBtnFinal').show(); }
                else { $('#nextBtn').show(); $('#submitBtnFinal').hide(); }

                // Update Step Circles
                $('.step-circle').each(function() {
                    const circleStep = parseInt($(this).data('step'));
                    if(circleStep <= step) {
                        $(this).addClass('active');
                    } else {
                        $(this).removeClass('active');
                    }
                });
            }

            $('#nextBtn').click(function() { $(`.step-content`).addClass('d-none'); step++; $(`#step-${step}`).removeClass('d-none'); updateUI(); });
            $('#prevBtn').click(function() { $(`.step-content`).addClass('d-none'); step--; $(`#step-${step}`).removeClass('d-none'); updateUI(); });

            // Radio Button Toggle for Step 1
            $('input[name="IsCustomSender"]').on('change', function() {
                if ($(this).val() === 'true') {
                    $('#otherInfoFields').slideDown(200);
                    $('#myInfoFields').slideUp(200);
                } else {
                    $('#otherInfoFields').slideUp(200);
                    $('#myInfoFields').slideDown(200);
                }
            });
            // RESTORED: COD Amount Toggle
            $('#codCheck').on('change', function() {
                if ($(this).is(':checked')) {
                    $('#codAmountWrapper').slideDown(200);
                } else {
                    $('#codAmountWrapper').slideUp(200);
                }
            });

            // Pricing logic
            function calc() {
                let s = parseFloat($('#calcSize').val()) || 0;
                let d = parseFloat($('#calcDest').val()) || 1;
                let total = (s * d) + ($('#fCheck').is(':checked') ? 5 : 0);
                $('#calcTotal').text('€' + total.toFixed(2));
            }
            $('#calcSize, #calcDest, #fCheck').change(calc);

            // Date setup
            const pDate = document.getElementById('pickupDate');
            const today = new Date().toISOString().split('T')[0];
            pDate.setAttribute('min', today);
            pDate.value = today;
        });
    </script>
}