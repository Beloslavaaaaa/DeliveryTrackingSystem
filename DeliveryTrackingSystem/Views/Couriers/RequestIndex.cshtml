@model IEnumerable<Cargobell.Shared.Models.CourierRequest>
@using Cargobell.Shared.Models
@{
    ViewData["Title"] = "Courier Services";
    string activeTab = ViewBag.ActiveTab ?? "active";
    var activeRequests = Model?.Where(r => !r.IsCompleted).ToList() ?? new List<CourierRequest>();
    var finishedRequests = Model?.Where(r => r.IsCompleted).ToList() ?? new List<CourierRequest>();
}

<div class="container py-5">
    <div class="mb-5">
        <h4 class="text-secondary small mb-1" style="letter-spacing: 3px;">SERVICE TERMINAL</h4>
        <h1 class="text-gold display-6 fw-bold">COURIER DISPATCH</h1>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger bg-black text-danger border-danger rounded-0 small mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        </div>
    }

    <div class="d-flex border-bottom border-secondary mb-4">
        <a href="?tab=active" class="py-2 px-4 text-decoration-none small fw-bold @(activeTab == "active" ? "text-gold border-bottom border-gold" : "text-secondary")">
            ACTIVE (@activeRequests.Count)
        </a>
        <a href="?tab=finished" class="py-2 px-4 text-decoration-none small fw-bold @(activeTab == "finished" ? "text-gold border-bottom border-gold" : "text-secondary")">
            HISTORY (@finishedRequests.Count)
        </a>
        <a href="?tab=create" class="ms-auto btn btn-gold btn-sm px-4 fw-bold">
            + NEW REQUEST
        </a>
    </div>

    <div class="mt-4">
        @if (activeTab == "active")
        {
            <div class="row g-4">
                @if (activeRequests.Any())
                {
                    @foreach (var req in activeRequests)
                    {
                        <div class="col-md-6">
                            <div class="card bg-dark border-secondary p-3 h-100 shadow">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <span class="badge border border-gold text-gold mb-2" style="font-size: 0.6rem;">@req.Status.ToUpper()</span>
                                        <h6 class="text-white fw-bold">@req.PackageDescription</h6>
                                        <div class="small mb-3">
                                            <p class="text-secondary mb-1"><i class="bi bi-geo-alt text-gold me-1"></i> FROM: @req.PickupAddress</p>
                                            <p class="text-secondary mb-1"><i class="bi bi-flag text-info me-1"></i> TO: @req.DropoffAddress</p>
                                        </div>
                                        @if (req.Status == "Pending")
                                        {
                                            <form action="/Couriers/Cancel/@req.CourierRequestId" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" style="font-size: 0.7rem;">CANCEL REQUEST</button>
                                            </form>
                                        }
                                    </div>
                                    <div class="text-end">
                                        <div class="text-gold fw-bold mb-1">€@req.EstimatedPrice.ToString("F2")</div>
                                        <div class="text-muted" style="font-size: 0.7rem;">@req.PreferredPickupTime.ToString("MMM dd, HH:mm")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5 border border-secondary border-dashed rounded" style="border-style: dashed !important;">
                        <p class="text-secondary mb-0 small uppercase">No active dispatch requests found.</p>
                    </div>
                }
            </div>
        }
        else if (activeTab == "finished")
        {
            @if (finishedRequests.Any())
            {
                <div class="table-responsive border border-secondary rounded">
                    <table class="table table-dark mb-0 small">
                        <thead>
                            <tr class="text-gold">
                                <th class="ps-4 py-3">DATE</th>
                                <th>DESCRIPTION</th>
                                <th>PRICE</th>
                                <th>DESTINATION</th>
                                <th class="pe-4 text-end">STATUS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in finishedRequests)
                            {
                                <tr>
                                    <td class="ps-4">@req.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    <td>@req.PackageDescription</td>
                                    <td class="text-gold">€@req.EstimatedPrice.ToString("F2")</td>
                                    <td>@req.DropoffAddress</td>
                                    <td class="pe-4 text-end">
                                        <span class="@(req.Status == "Cancelled" ? "text-danger" : "text-success") small uppercase fw-bold">@req.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else if (activeTab == "create")
        {
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card bg-dark border-gold p-4 shadow-lg">
                        <form action="/Couriers/Create" method="post" id="dispatchForm">
                            @Html.AntiForgeryToken()
                            
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="text-gold small fw-bold mb-2">PACKAGE TYPE</label>
                                    <select name="PackageType" id="packageType" class="form-control bg-transparent text-white border-secondary" required>
                                        <option value="Envelope" data-price="5" style="background:#000;">Document Envelope (Up to 0.5kg)</option>
                                        <option value="Small" data-price="15" style="background:#000;">Small Parcel (Up to 2kg)</option>
                                        <option value="Standard" data-price="35" style="background:#000;">Standard Box (Up to 10kg)</option>
                                        <option value="Heavy" data-price="70" style="background:#000;">Heavy Freight (Up to 30kg)</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="text-gold small fw-bold mb-2">DESTINATION ZONE</label>
                                    <select name="DestinationZone" id="destZone" class="form-control bg-transparent text-white border-secondary" required>
                                        <option value="Domestic" data-mult="1" style="background:#000;">Domestic (Bulgaria)</option>
                                        <option value="EU" data-mult="2.5" style="background:#000;">International (Europe)</option>
                                        <option value="Global" data-mult="5" style="background:#000;">International (Global)</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="text-gold small fw-bold mb-2">CONTENT DESCRIPTION</label>
                                <input name="PackageDescription" class="form-control bg-transparent text-white border-secondary" placeholder="e.g. Laptop, Fragile Vases..." required />
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="text-gold small fw-bold mb-2">PICKUP ADDRESS</label>
                                    <input name="PickupAddress" class="form-control bg-transparent text-white border-secondary" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="text-gold small fw-bold mb-2">DROPOFF ADDRESS</label>
                                    <input name="DropoffAddress" class="form-control bg-transparent text-white border-secondary" required />
                                </div>
                            </div>

                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <label class="text-gold small fw-bold mb-2">PICKUP TIME</label>
                                    <input name="PreferredPickupTime" id="pickupTime" type="datetime-local" class="form-control bg-transparent text-white border-secondary" required />
                                </div>
                                <div class="col-md-6 d-flex align-items-end">
                                    <div class="bg-black border border-secondary p-2 w-100 text-center">
                                        <small class="text-secondary d-block uppercase" style="font-size: 0.6rem;">Estimated Fee</small>
                                        <span id="livePrice" class="text-gold fw-bold fs-4">€5.00</span>
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-gold w-100 py-3 fw-bold">INITIALIZE DISPATCH</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // 1. Изчисляване на цена
            function calculateLivePrice() {
                var base = parseFloat($('#packageType option:selected').data('price')) || 0;
                var mult = parseFloat($('#destZone option:selected').data('mult')) || 1;
                $('#livePrice').text('€' + (base * mult).toFixed(2));
            }
            $('#packageType, #destZone').on('change', calculateLivePrice);

            // 2. Блокиране на минали дати
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            const minDateTime = now.toISOString().slice(0, 16);
            
            $('#pickupTime').attr('min', minDateTime);
            $('#pickupTime').val(minDateTime);

            // 3. Последна проверка при Submit
            $('#dispatchForm').on('submit', function(e) {
                const selected = new Date($('#pickupTime').val());
                if (selected < new Date()) {
                    alert("ERROR: Time cannot be in the past.");
                    e.preventDefault();
                }
            });
        });
    </script>
}