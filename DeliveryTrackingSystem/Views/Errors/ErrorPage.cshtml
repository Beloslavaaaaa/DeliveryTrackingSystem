@{
    Layout = "_Layout";
    var returnUrl = User.Identity.IsAuthenticated ? "/Dashboard" : "/";
}

<div class="text-center py-5 my-5">
    <h1 class="display-1 fw-bold text-gold" style="letter-spacing: 15px; opacity: 0.5;">@ViewData["ErrorCode"]</h1>
    <div style="margin-top: -60px;">
        <h2 class="text-white fw-bold mb-3">@ViewData["Message"]</h2>
        <p class="text-secondary mx-auto mb-5" style="max-width: 500px;">@ViewData["Subline"]</p>

        <div class="d-flex justify-content-center gap-3">

            <a href="@returnUrl" class="btn btn-outline-gold px-4 py-2">RETURN TO COMMAND</a>
            <a href="/Home/Contact" class="btn btn-gold px-4 py-2">REPORT DISCREPANCY</a>
        </div>
    </div>
</div>

<style>
    body {
        background: radial-gradient(circle at center, #111 0%, #050505 100%) !important;
    }
</style>