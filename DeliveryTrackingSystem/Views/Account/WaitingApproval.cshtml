@using Microsoft.AspNetCore.Identity
@using Cargobell.Shared.Models
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Terminal Access | Cargobell";
    var user = await UserManager.GetUserAsync(User);
    bool isRejected = user?.DeclarationFilePath == "REJECTED";
}

<div class="container py-5 mt-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8">
            
            @if (isRejected)
            {
                <div class="p-5 border-danger shadow-lg" style="background: rgba(10, 10, 10, 0.9); backdrop-filter: blur(15px); border: 1px solid #dc3545;">
                    <i class="bi bi-x-octagon display-1 text-danger mb-4"></i>
                    
                    <h2 class="text-danger fw-bold mb-3 text-uppercase" style="letter-spacing: 3px;">Access Denied</h2>
                    
                    <p class="text-white fs-5 mb-4">
                        Sorry, the declaration you provided doesn't cover our requirements.
                        Your account activation has been denied by the terminal authorities.
                    </p>
                    
                    <div class="p-3 mb-4 rounded" style="background: rgba(220, 53, 69, 0.1); border: 1px dashed #dc3545;">
                        <p class="text-danger small mb-0 text-uppercase" style="letter-spacing: 1px;">
                            Reason: <span class="fw-bold">Invalid or Insufficient Documentation</span>
                        </p>
                    </div>

                    <div class="d-flex justify-content-center gap-3">
                        <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-danger px-5 py-3 fw-bold">CONTACT SUPPORT</a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-danger px-5 py-3 fw-bold">EXIT TERMINAL</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="p-5 border-gold shadow-lg" style="background: rgba(10, 10, 10, 0.9); backdrop-filter: blur(15px); border: 1px solid #D4AF37;">
                    <i class="bi bi-shield-lock display-1 text-gold mb-4"></i>
                    
                    <h2 class="text-gold fw-bold mb-3 text-uppercase" style="letter-spacing: 3px;">Membership Pending</h2>
                    
                    <p class="text-white fs-5 mb-4">
                        Thank you for joining the Cargobell network. Because you are under 18,
                        our executive team must verify your parental declaration before your account is activated.
                    </p>
                    
                    <div class="p-3 mb-4 rounded" style="background: rgba(212, 175, 55, 0.1); border: 1px dashed #D4AF37;">
                        <p class="text-gold small mb-0 text-uppercase" style="letter-spacing: 1px;">
                            Current Status: <span class="fw-bold">Awaiting Courier Verification</span>
                        </p>
                    </div>

                    <p class="text-secondary small mb-5">
                        You will receive access to your command center once a courier reviews your documents.
                    </p>

                    <div class="d-flex justify-content-center gap-3">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-gold px-5 py-3 fw-bold">RETURN TO HOME</a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-gold px-5 py-3 fw-bold">EXIT TERMINAL</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>