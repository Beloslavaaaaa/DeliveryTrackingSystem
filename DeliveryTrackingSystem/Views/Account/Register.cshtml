@model DeliveryTrackingSystem.Models.RegisterViewModel
@{
    ViewData["Title"] = "Join Cargobell | Elite Registration";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-5 border-gold shadow-lg" style="background: rgba(10, 10, 10, 0.9); backdrop-filter: blur(15px); border: 1px solid #D4AF37;">
                <div class="text-center mb-4">
                    <h2 class="text-gold h3 fw-bold">MEMBERSHIP</h2>
                    <p class="text-secondary small text-uppercase" style="letter-spacing: 2px;">Join the Global Elite</p>
                </div>

                <form asp-controller="Account" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="FirstName" class="form-label small text-gold">FIRST NAME</label>
                            <input asp-for="FirstName" class="form-control bg-dark text-white border-secondary py-3" placeholder="John" style="background-color: #111 !important; color: white !important;" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="LastName" class="form-label small text-gold">LAST NAME</label>
                            <input asp-for="LastName" class="form-control bg-dark text-white border-secondary py-3" placeholder="Doe" style="background-color: #111 !important; color: white !important;" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label small text-gold">EMAIL ADDRESS</label>
                        <input asp-for="Email" class="form-control bg-dark text-white border-secondary py-3" placeholder="name@cargobell.com" style="background-color: #111 !important; color: white !important;" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="form-label small text-gold">PHONE NUMBER</label>
                        <input asp-for="PhoneNumber" class="form-control bg-dark text-white border-secondary py-3" placeholder="+1..." style="background-color: #111 !important; color: white !important;" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DateOfBirth" class="form-label small text-gold">DATE OF BIRTH</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control bg-dark text-white border-secondary py-3" style="background-color: #111 !important; color: white !important;" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label small text-gold">PASSWORD</label>
                        <input asp-for="Password" type="password" class="form-control bg-dark text-white border-secondary py-3" placeholder="••••••••" style="background-color: #111 !important; color: white !important;" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small text-gold">CONFIRM PASSWORD</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control bg-dark text-white border-secondary py-3" placeholder="••••••••" style="background-color: #111 !important; color: white !important;" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-gold w-100 py-3 mb-4">REGISTER MEMBERSHIP</button>

                    <div class="text-center mt-3">
                        <a asp-controller="Account" asp-action="Login" class="text-secondary small text-decoration-none">Already a member? <span class="text-gold fw-bold">Sign In</span></a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}