@model Cargobell.Shared.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Terminal Access";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card p-5 border-gold shadow-lg" style="background: rgba(10, 10, 10, 0.9); backdrop-filter: blur(15px); border: 1px solid #D4AF37;">
                <div class="text-center mb-4">
                    <h2 class="text-gold h3 fw-bold">ACCESS</h2>
                    <p class="text-secondary small text-uppercase" style="letter-spacing: 2px;">Identity Verification</p>
                </div>

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All" class="text-danger small mb-4 fw-bold"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label small text-gold">EMAIL</label>
                        <input asp-for="Email" class="form-control bg-dark text-white border-secondary py-3" style="background-color: #111 !important; color: white !important;" placeholder="name@cargobell.com" />
                        </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label small text-gold">PASSWORD</label>
                        <input asp-for="Password" type="password" class="form-control bg-dark text-white border-secondary py-3" style="background-color: #111 !important; color: white !important;" placeholder="••••••••" />
                        </div>

                    <div class="mb-4 form-check">
                        <input asp-for="RememberMe" class="form-check-input" style="border-color: #D4AF37; background-color: transparent;" />
                        <label asp-for="RememberMe" class="form-check-label small text-secondary">Stay authenticated</label>
                    </div>

                    <button type="submit" class="btn btn-gold w-100 py-3 mb-4">AUTHORIZE</button>

                    <div class="text-center">
                         <a asp-controller="Account" asp-action="Register" class="text-secondary small text-decoration-none">New Operative? <span class="text-gold fw-bold">Register</span></a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}