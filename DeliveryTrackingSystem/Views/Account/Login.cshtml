@model DeliveryTrackingSystem.Models.LoginViewModel
@{
    ViewData["Title"] = "Secure Terminal | Sign In";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card p-5 border-gold shadow-lg" style="background: rgba(255,255,255,0.02); backdrop-filter: blur(15px); border: 1px solid #D4AF37;">
                <div class="text-center mb-4">
                    <h2 class="text-gold h3 fw-bold">TERMINAL ACCESS</h2>
                    <p class="text-secondary small text-uppercase" style="letter-spacing: 2px;">Identity Verification Required</p>
                </div>

                <form asp-controller="Account" asp-action="Login" method="post">
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label class="form-label small text-gold">EMAIL ADDRESS</label>
                        <input asp-for="Email" class="form-control bg-transparent text-white border-secondary py-3" placeholder="name@cargobell.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-gold">PASSWORD</label>
                        <input asp-for="Password" type="password" class="form-control bg-transparent text-white border-secondary py-3" placeholder="••••••••" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="RememberMe" class="form-check-input" style="background-color: transparent; border-color: #D4AF37;" />
                        <label asp-for="RememberMe" class="form-check-label small text-secondary">Keep session active</label>
                    </div>

                    <button type="submit" class="btn btn-gold w-100 py-3 mb-4">AUTHORIZE ACCESS</button>

                    <div class="text-center mt-3">
                        <a asp-controller="Account" asp-action="Register" class="text-secondary small text-decoration-none">New operative? <span class="text-gold fw-bold">Request Access</span></a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>